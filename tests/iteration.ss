($check (not (assoc 0 tombstone-entries)))
($check (not (assoc 64 tombstone-entries)))
($check (not (assoc 129 tombstone-entries)))
($check (= 126 (entry-value tombstone-entries 63)))
($check (= 130 (entry-value tombstone-entries 65)))

