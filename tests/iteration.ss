(define cursor (%iter (vector 10 20 30)))
($check (= 10 (%if/next! ((value) cursor) value)))
($check (= 21 (%if/next! ((value) cursor) (+ value 1))))
($check (= 30 (%if/next! ((value) cursor) value 'exhausted)))
($check (eq? 'exhausted (%if/next! ((value) cursor) value 'exhausted)))
(%if/next! ((value) (%iter (vector))) value)

($check (= 33 (%if/next! ((value) (%iter (vector 33))) value)))

(define (cursor-first cursor)
  (%if/next! ((value) cursor) value 'empty))
($check (= 34 (cursor-first (%iter (vector 34)))))
($check (eq? 'empty (cursor-first (%iter (vector)))))

(define growing-vector (vector 1 2))
(define growing-cursor (%iter growing-vector))
($check (= 1 (%if/next! ((value) growing-cursor) value)))
(vector-push! growing-vector 3)
($check (= 2 (%if/next! ((value) growing-cursor) value)))
($check (= 3 (%if/next! ((value) growing-cursor) value)))
($check (eq? 'done (%if/next! ((value) growing-cursor) value 'done)))

(define replaced-vector (vector 10 20))
(define replaced-cursor (%iter replaced-vector))
($check (= 10 (%if/next! ((value) replaced-cursor) value)))
(setf! replaced-vector 1 21)
($check (= 21 (%if/next! ((value) replaced-cursor) value)))

(define removed-visited-vector (vector 30 40 50))
(define removed-visited-cursor (%iter removed-visited-vector))
($check (= 30 (%if/next! ((value) removed-visited-cursor) value)))
($check (= 30 (vector-pop-first! removed-visited-vector)))
($check (= 40 (%if/next! ((value) removed-visited-cursor) value)))

(define removed-next-vector (vector 60 70))
(define removed-next-cursor (%iter removed-next-vector))
($check (= 60 (%if/next! ((value) removed-next-cursor) value)))
($check (= 70 (vector-pop! removed-next-vector)))
($check (eq? 'done (%if/next! ((value) removed-next-cursor) value 'done)))

(define replaced-tail-vector (vector 80))
(define replaced-tail-cursor (%iter replaced-tail-vector))
($check (= 80 (%if/next! ((value) replaced-tail-cursor) value)))
($check (= 80 (vector-pop! replaced-tail-vector)))
(vector-push! replaced-tail-vector 81)
($check (= 81 (%if/next! ((value) replaced-tail-cursor) value)))

(define shared-vector (vector 90 100 110))
(define shared-cursor-a (%iter shared-vector))
(define shared-cursor-b (%iter shared-vector))
($check (= 90 (%if/next! ((value) shared-cursor-a) value)))
(vector-pop-first! shared-vector)
($check (= 100 (%if/next! ((value) shared-cursor-a) value)))
($check (= 100 (%if/next! ((value) shared-cursor-b) value)))
($check (= 110 (%if/next! ((value) shared-cursor-a) value)))
($check (eq? 'done (%if/next! ((value) shared-cursor-a) value 'done)))
($check (= 110 (%if/next! ((value) shared-cursor-b) value)))
($check (eq? 'done (%if/next! ((value) shared-cursor-b) value 'done)))

(define equal-cursor-target (vector 1 2))
(define equal-cursor-a (%iter equal-cursor-target))
(define equal-cursor-b (%iter equal-cursor-target))
(define equal-cursor-other (%iter (vector 1 2)))
($check (equal? equal-cursor-a equal-cursor-b))
($check (not (equal? equal-cursor-a equal-cursor-other)))
(%if/next! ((value) equal-cursor-a) value)
($check (not (equal? equal-cursor-a equal-cursor-b)))
(%if/next! ((value) equal-cursor-b) value)
($check (equal? equal-cursor-a equal-cursor-b))
(%if/next! ((value) equal-cursor-a) value)
(%if/next! ((value) equal-cursor-b) value)
($check (equal? equal-cursor-a equal-cursor-b))
($check (eq? 'done (%if/next! ((value) equal-cursor-a) value 'done)))
($check (not (equal? equal-cursor-a equal-cursor-b)))
($check (eq? 'done (%if/next! ((value) equal-cursor-b) value 'done)))
($check (equal? equal-cursor-a equal-cursor-b))

(define outer 'outer)
(define scope-cursor (%iter (vector 'inner)))
($check (eq? 'inner (%if/next! ((outer) scope-cursor) outer)))
($check (eq? 'outer outer))
($check (eq? 'outer (%if/next! ((outer) (%iter (vector))) outer outer)))

(define (capture-values values)
  (let ((cursor (%iter values)))
    (let loop ((result '()))
      (%if/next! ((value) cursor) (loop (cons (lambda () value) result)) result))))
(define captured-values (capture-values (vector 1 2 3)))
($check (= 3 ((first captured-values))))
($check (= 2 ((second captured-values))))
($check (= 1 ((third captured-values))))

(define capture-cursor (%iter (vector 40 50)))
(define captured (%if/next! ((value) capture-cursor) (lambda () value)))
($check (= 40 (captured)))
(define mutated
  (%if/next! ((value) capture-cursor) (begin
      (set! value (+ value 1))
      (lambda () value))))
($check (= 51 (mutated)))

(define (sum-cursor cursor total)
  (%if/next! ((value) cursor) (sum-cursor cursor (+ total value)) total))
($check (= 15 (sum-cursor (%iter (vector 1 2 3 4 5)) 0)))

(define outer-cursor (%iter (vector 1 2)))
(define inner-cursor (%iter (vector 10 20)))
($check
  (= 11
     (%if/next! ((outer-value) outer-cursor) (%if/next! ((inner-value) inner-cursor) (+ outer-value inner-value)))))

(define retained-cursor (%iter (vector 42)))
(let loop ((i 0))
  (if (< i 10000)
      (begin
        (vector i i i i i i i i)
        (loop (+ i 1)))))
($check (= 42 (%if/next! ((value) retained-cursor) value)))

(define (cursor-entries cursor)
  (%if/next! ((key value) cursor) (cons (cons key value) (cursor-entries cursor)) '()))
(define (entry-value entries key)
  (cdr (assoc key entries)))

(define empty-map-cursor (%iter (hashmap)))
($check (null? (cursor-entries empty-map-cursor)))
(define one-map-entries (cursor-entries (%iter (hashmap 'one 1))))
($check (= 1 (length one-map-entries)))
($check (= 1 (entry-value one-map-entries 'one)))
(define many-map-entries (cursor-entries (%iter (hashmap 'a 1 'b 2 'c 3))))
($check (= 3 (length many-map-entries)))
($check (= 1 (entry-value many-map-entries 'a)))
($check (= 2 (entry-value many-map-entries 'b)))
($check (= 3 (entry-value many-map-entries 'c)))

