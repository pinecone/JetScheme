(define (cursor-values cursor)
  (%if/next! ((value) cursor) (cons value (cursor-values cursor)) '()))

(define (values-hashset values)
  (let ((set (hashset)))
    (let add ((values values))
      (if (null? values)
          set
          (begin
            (setf! set (car values) #t)
            (add (cdr values)))))))

($check (null? (cursor-values (%iter (hashset)))))
(define one-set-values (cursor-values (%iter (hashset 'one))))
($check (= 1 (length one-set-values)))
($check (equal? (hashset 'one) (values-hashset one-set-values)))
(define many-set-values (cursor-values (%iter (hashset 'a 'b 'c))))
($check (= 3 (length many-set-values)))
($check (equal? (hashset 'a 'b 'c) (values-hashset many-set-values)))

