;;; generic iteration surface: `%iter`, `%if/next!`, two-output protocol, `coro/next`

($check (= 10 (%if/next! ((v) (%iter (vector 10 20))) v 'none)))

(define public-vector-cursor (%iter (vector 5 6)))
($check (= 5 (%if/next! ((v) public-vector-cursor) v)))
($check (= 6 (%if/next! ((v) public-vector-cursor) v)))
($check (eq? 'done (%if/next! ((v) public-vector-cursor) v 'done)))

(define shared-step-cursor (%iter (vector 1 2)))
($check (= 1 (%if/next! ((v) shared-step-cursor) v)))
($check (= 2 (%if/next! ((v) shared-step-cursor) v)))

(define vector-pairs (%iter (vector 10 20 30)))
($check (equal? (cons 0 10) (%if/next! ((k v) vector-pairs) (cons k v))))
($check (equal? (cons 1 20) (%if/next! ((k v) vector-pairs) (cons k v))))
($check (equal? (cons 2 30) (%if/next! ((k v) vector-pairs) (cons k v))))
($check (eq? 'done (%if/next! ((k v) vector-pairs) (cons k v) 'done)))

(define set-pairs (%iter (hashset 'only)))
($check (%if/next! ((k v) set-pairs) (and (eq? k 'only) (eq? v 'only)) #f))
($check (eq? 'done (%if/next! ((k v) set-pairs) v 'done)))

(define map-values (%iter (hashmap 'a 7)))
($check (= 7 (%if/next! ((v) map-values) v)))
($check (eq? 'done (%if/next! ((v) map-values) v 'done)))

(define map-pairs (%iter (hashmap 'a 7)))
($check (equal? (cons 'a 7) (%if/next! ((k v) map-pairs) (cons k v))))
($check (eq? 'done (%if/next! ((k v) map-pairs) (cons k v) 'done)))

(define coro-one (let/coro yield () (yield 1) (yield 2) 3))
($check (= 1 (%if/next! ((v) coro-one) v)))
($check (= 2 (%if/next! ((v) coro-one) v)))
($check (= 3 (%if/next! ((v) coro-one) v)))
($check (eq? 'done (%if/next! ((v) coro-one) v 'done)))

(define coro-two (let/coro yield () (yield 10) 20))
($check (= 10 (%if/next! ((k v) coro-two) v)))
($check (= 20 (%if/next! ((k v) coro-two) v)))
($check (eq? 'done (%if/next! ((k v) coro-two) v 'done)))

(define coro-next-target (let/coro yield () (yield 1) (yield 2) 3))
($check (= 1 (coro/next coro-next-target 'done)))
($check (= 2 (coro/next coro-next-target 'done)))
($check (= 3 (coro/next coro-next-target 'done)))
($check (eq? 'done (coro/next coro-next-target 'done)))
