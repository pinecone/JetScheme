(define plus:*ui-width* 320)
(define plus:*screen-offset* 0)

(define plus:*base-keyboard-move* PollKeyboardMove)
(define plus:*base-pc-render* pc-render)
(define plus:*base-view-size* SetViewSize)
(define plus:*base-preview* ShowViewSize)
(define plus:*base-refresh* ThreeDRefresh)
(define plus:*base-clear-split* ClearSplitVWB)

(define plus:*requested* (option "--plus" #f))
(define plus:*enabled*
  (if (eq? demo-action 'play) (= (ref demo-data 5) 1) plus:*requested*))
(define plus:*active* plus:*enabled*)
(define plus:*key* #f)
(define plus:*output-width* plus:*ui-width*)
(define plus:*output-ready* #f)
(define plus:*mip-steps* 8)
(define plus:*mip-levels* 7)
(define plus:*mips* #f)
(define plus:*base-palette* #f)
(define plus:*resources* #f)
(define plus:*deadline* #f)
(define plus:*build-slice* (/ 1 120))

(define plus:*turn-speed* (option "--turn-speed" 62.5))
(define plus:*walk-speed* (option "--walk-speed" 52.5))

(define plus:wall-mip-entry (struct 'plus:wall-mip-entry '(width height texels)))
(define plus:sprite-mip-entry (struct 'plus:sprite-mip-entry '(size colors coverage)))
(define plus:palette-sample-entry
  (struct 'plus:palette-sample-entry '(nearest error limit pixel-error)))

(define (clamp value minimum maximum)
  (max minimum (min maximum value)))

(define (plus:keyboard-move)
  (if plus:*active*
      (let* ((step (* (if (ref buttonstate bt_run) 70 plus:*walk-speed*) tics))
             (turn (if (ref buttonstate bt_strafe) step (* plus:*turn-speed* tics))))
        (when (ref Keyboard (ref dirscan 0)) (set! controly (- controly step)))
        (when (ref Keyboard (ref dirscan 2)) (set! controly (+ controly step)))
        (when (ref Keyboard (ref dirscan 3)) (set! controlx (- controlx turn)))
        (when (ref Keyboard (ref dirscan 1)) (set! controlx (+ controlx turn))))
      (plus:*base-keyboard-move*)))

(define (plus:samples data length)
  (if plus:*active*
      (let ((samples (make-bytevector length PCSILENCE)))
        (let copy ((index 0))
          (when (< index length)
            (setf! samples index (+ PCSILENCE (quotient (- (ref data index) PCSILENCE) 2)))
            (copy (+ index 1))))
        samples)
      (bytevector-copy data 0 length)))

(define (plus:pc-render data length)
  (if plus:*active*
      (let* ((persample (truncate (/ PCRATE PCSERVICERATE)))
             (high (+ PCSILENCE (quotient (- PCHIGH PCSILENCE) 2)))
             (low (+ PCSILENCE (quotient (- PCLOW PCSILENCE) 2)))
             (pcm (make-bytevector (* length persample) PCSILENCE)))
        (define (ticks tick out phase)
          (if (= tick length)
              pcm
              (let ((sample (ref data (+ SOUNDCOMMONSIZE tick))))
                (if (zero? sample)
                    (ticks (+ tick 1) (+ out persample) phase)
                    (emit (/ (/ PCBASETIMER (ref pcSoundLookup sample)) PCRATE)
                          tick out 0 phase)))))

        (define (emit step tick out offset phase)
          (if (= offset persample)
              (ticks (+ tick 1) (+ out persample) phase)
              (let* ((moved (+ phase step))
                     (next-phase (- moved (truncate moved))))
                (setf! pcm (+ out offset) (if (< next-phase 0.5) high low))
                (emit step tick out (+ offset 1) next-phase))))

        (ticks 0 0 0))
      (plus:*base-pc-render* data length)))

(define plus:*light-radius* 6)
(define plus:*light-levels* 8)
(define plus:*chandelier-levels* 9)
(define plus:*light-step* 16)
(define plus:*ambient-depth* 96)
(define plus:*distance-depth* 32)
(define plus:*level-min* -64)
(define plus:*level-max* 240)
(define plus:*level-count* (+ 1 (- plus:*level-max* plus:*level-min*)))
(define plus:*shade-step* 4)
(define plus:*shade-count* (+ 1 (/ (- plus:*level-count* 1) plus:*shade-step*)))
(define plus:*emissive-luma* 48)
(define plus:*flash-max-level* 32)
(define plus:*flash-tics* 8)
(define plus:*flash-count* 4)
(define plus:*ao-width* (/ TILEGLOBAL 40))
(define plus:*ao-step* 4)
(define plus:*dither-contrast* 0.25)
(define plus:*corner-depth* 3)
(define plus:*ao-depths* (vector 0 1 plus:*corner-depth*))
(define plus:*ao-shades* #f)
(define plus:*corner-shades* #f)
(define plus:*pillar-shades* #f)
(define plus:*palette-slots* #(5 80 81 82 83 84 85 86 87 166 167 168 169 170 176 177 178 181 255))
(define plus:*shadow-depth* 48)
(define plus:*pillar* (+ SPR_STAT_0 7))

(define plus:*wall-height* (make-vector viewwidth 0))
(define plus:*wall-x* (make-vector viewwidth 0))
(define plus:*wall-y* (make-vector viewwidth 0))
(define plus:*last-hit* #f)
(define plus:*last-vertical-x-tile* 0)
(define plus:*last-vertical-tile* 0)
(define plus:*last-vertical-texture* 0)
(define plus:*last-horizontal-y-tile* 0)
(define plus:*last-horizontal-tile* 0)
(define plus:*last-horizontal-texture* 0)
(define plus:*last-door-number* 0)
(define plus:*last-door-texture* 0)
(define plus:*last-pwall-tile* 0)
(define plus:*last-pwall-texture* 0)

(define plus:*vis-x* (make-vector MAXVISABLE 0))
(define plus:*vis-height* (make-vector MAXVISABLE 0))
(define plus:*vis-shape* (make-vector MAXVISABLE 0))
(define plus:*vis-tile-x* (make-vector MAXVISABLE 0))
(define plus:*vis-tile-y* (make-vector MAXVISABLE 0))
(define plus:*vis-order* (make-vector MAXVISABLE 0))
(define plus:*vis-count* 0)

(define plus:*boundaries* (make-vector (vector-length plus:*wall-height*) 0))
(define plus:*plane-x* (make-vector (vector-length plus:*wall-height*) 0))
(define plus:*plane-y* (make-vector (vector-length plus:*wall-height*) 0))
(define plus:*shades*
  (let ((identity (make-bytevector 256 0)))
    (let colors ((color 0))
      (when (< color 256)
        (setf! identity color color)
        (colors (+ color 1))))
    (make-vector plus:*shade-count* identity)))
(define plus:*emissive* (make-bytevector 256 0))
(define plus:*luma* (make-bytevector 256 0))
(define plus:*sprites* (make-vector 0 #f))
(define plus:*sprite-mips* #f)
(define plus:*blends* #f)
(define plus:*feet* (make-vector 0 #f))
(define plus:*mounts* (make-vector 0 #f))
(define plus:*contacts*
  '#(none floor floor floor ceiling ceiling floor both
     floor floor floor floor floor floor ceiling ceiling
     floor ceiling ceiling floor floor floor floor floor
     floor floor floor floor floor floor floor floor
     floor floor none floor floor floor none floor
     none floor floor floor ceiling floor floor both))
(define plus:*light-map* (make-vector (* MAPSIZE MAPSIZE) 0))
(define plus:*light-base* (make-vector (* MAPSIZE MAPSIZE) 0))
(define plus:*light-paths* (make-vector (* MAPSIZE MAPSIZE) '()))
(define plus:*secret-map* (make-bytevector (* MAPSIZE MAPSIZE) 0))
(define plus:*secret-spots* #())
(define plus:*secret-transmissions* (make-vector (* MAPSIZE MAPSIZE) -1))
(define plus:*light-watch* (make-vector (+ MAXDOORS (* MAPSIZE MAPSIZE)) #()))
(define plus:*light-positions* (make-vector MAXDOORS -1))
(define plus:*light-dirty* (make-bytevector (* MAPSIZE MAPSIZE) 0))
(define plus:*light-queue* (make-vector (* MAPSIZE MAPSIZE) 0))
(define plus:*light-count* 0)
(define plus:*light-samples* (make-vector 4 0))
(define plus:*light-cells* (make-vector (* MAPSIZE MAPSIZE 4) 0))
; Cell bits run left to right, then top to bottom.
(define plus:*light-masks* (make-bytevector (* MAPSIZE MAPSIZE) 0))
(define plus:*flash-maps*
  (let ((maps (make-vector plus:*flash-count* #f)))
    (let slots ((slot 0))
      (when (< slot plus:*flash-count*)
        (setf! maps slot (make-bytevector (* MAPSIZE MAPSIZE) 0))
        (slots (+ slot 1))))
    maps))
(define plus:*neighbors* #(#(-1 0) #(1 0) #(0 -1) #(0 1)))
(define plus:*flash-starts* (make-vector plus:*flash-count* -1))
(define plus:*flash-next* 0)
(define plus:*flash-time* #f)
(define plus:*flash-active* #f)
(define plus:*flash-epoch* 0)
(define plus:*flash-remaining* (make-vector plus:*flash-count* 0))
(define plus:*flash-epochs* (make-vector (* MAPSIZE MAPSIZE) -1))
(define plus:*flash-levels* (make-bytevector (* MAPSIZE MAPSIZE) 0))

(define (plus:update-output)
  (when plus:*enabled*
    (set! plus:*output-width*
          (max plus:*ui-width* (* 2 (round (/ (* screenheight 1.2 (dos:output-width))
                                             (* 2 (dos:output-height)))))))
    ; Fades keep framebuffer snapshots across yields; later resizes wait for plus-refresh.
    (unless plus:*output-ready*
      (set! plus:*output-ready* #t)
      (plus:resize))))

(define (plus:copy-ui! source stride offset)
  (let rows ((row 0))
    (when (< row screenheight)
      (let ((start (+ (* row stride) offset)))
        (bytevector-copy! framebuffer (+ (* row screenwidth) plus:*screen-offset*)
                          source start (+ start plus:*ui-width*)))
      (rows (+ row 1)))))

(define (plus:reset-render-buffers! width)
  (set! pixelangle (make-vector width 0))
  (set! wallheight (make-vector width 0))
  (set! plus:*wall-height* (make-vector width 0))
  (set! plus:*wall-x* (make-vector width 0))
  (set! plus:*wall-y* (make-vector width 0))
  (set! plus:*boundaries* (make-vector width 0))
  (set! plus:*plane-x* (make-vector width 0))
  (set! plus:*plane-y* (make-vector width 0)))

(define (plus:resize)
  (let ((width (if plus:*active* plus:*output-width* plus:*ui-width*)))
    (if (= width screenwidth)
        #f
        (let ((source framebuffer)
              (stride screenwidth)
              (offset plus:*screen-offset*))
          (unless demo-headless (dos:set-framebuffer-size width screenheight))
          (set! screenwidth width)
          (set! plus:*screen-offset* (quotient (- width plus:*ui-width*) 2))

          (set! framebuffer (make-bytevector (* width screenheight) 127))
          (plus:copy-ui! source stride offset)
          (set! displayframebuffer (bytevector-copy framebuffer 0 (bytevector-length framebuffer)))
          (set! UPDATEWIDE (quotient (+ width 15) 16))
          (set! update (make-bytevector (* UPDATEWIDE UPDATEHIGH) 1))

          (plus:reset-render-buffers! width)
          (plus:view-size (* viewsize 16) (* viewsize 8))
          #t))))

(define (plus:calc-projection focal projection-width)
  (set! focallength focal)
  (set! facedist (+ focal MINDIST))
  (let ((halfview (/ viewwidth 2))
        (radtoint (/ (/ FINEANGLES 2) pi)))
    (set! scale (truncate (/ (* projection-width facedist) VIEWGLOBAL)))
    (set! heightnumerator (truncate (/ (* TILEGLOBAL scale) 64)))
    (let loop ((index 0))
      (when (< index halfview)
        (let* ((tang (/ (truncate (/ (* index VIEWGLOBAL) projection-width)) facedist))
               (intang (truncate (* (atan tang) radtoint))))
          (setf! pixelangle (- halfview 1 index) intang)
          (setf! pixelangle (+ halfview index) (- intang)))
        (loop (+ index 1))))
    (set! minheightdiv (+ (truncate (/ heightnumerator #x7fff)) 1))
    (set! maxslope (arithmetic-shift (ref finetangent (ref pixelangle 0)) -8))))

(define (plus:view-size width height)
  (if (= screenwidth plus:*ui-width*)
      (plus:*base-view-size* width height)
      (let ((projection (* 16 (truncate (/ width 16)))))
        (set! viewwidth (+ projection (- screenwidth plus:*ui-width*)))
        (set! viewheight (* 2 (truncate (/ height 2))))
        (set! viewleft (truncate (/ (- screenwidth viewwidth) 2)))
        (set! viewtop (truncate (/ (- (- screenheight STATUSLINES) viewheight) 2)))
        (set! centerx (- (truncate (/ viewwidth 2)) 1))
        (set! shootdelta (truncate (/ projection 10)))
        (plus:calc-projection FOCALLENGTH projection)
        (SetupScaling (truncate (* projection 1.5)))
        #t)))

(define (plus:preview size)
  (if (= screenwidth plus:*ui-width*)
      (plus:*base-preview* size)
      (let ((old-width viewwidth)
            (old-height viewheight)
            (old-left viewleft)
            (old-top viewtop))
        (set! viewwidth (+ (* size 16) (- screenwidth plus:*ui-width*)))
        (set! viewheight (* size 8))
        (set! viewleft (truncate (/ (- screenwidth viewwidth) 2)))
        (set! viewtop (truncate (/ (- (- screenheight STATUSLINES) viewheight) 2)))
        (DrawPlayBorder)
        (set! viewwidth old-width)
        (set! viewheight old-height)
        (set! viewleft old-left)
        (set! viewtop old-top))))

(define (plus:shade level)
  (truncate (/ (+ (- level plus:*level-min*) (/ plus:*shade-step* 2)) plus:*shade-step*)))

(define (plus:color color level)
  (if plus:*active* (ref plus:*shades* (plus:shade level) color) color))

(define (plus:shaded-sprite-color color shade emissive)
  (ref (if (and emissive (= (ref plus:*emissive* color) 1)) emissive shade) color))

(define (plus:distance-falloff-level extent range)
  (if plus:*active*
      (let ((distance (- range (min extent range))))
        (truncate (/ (* plus:*distance-depth* distance distance distance distance)
                     (* range range range range))))
      0))

(define (plus:light-index tilex tiley)
  (+ (* tiley MAPSIZE) tilex))

(define (plus:update-flashes)
  (when plus:*active*
    (unless (and plus:*flash-time* (= plus:*flash-time* TimeCount))
      (set! plus:*flash-active* #f)
      (let slots ((slot 0))
        (when (< slot plus:*flash-count*)
          (let* ((start (ref plus:*flash-starts* slot))
                 (remaining (if (or (< start 0) (> start TimeCount))
                                0
                                (max 0 (- plus:*flash-tics* (- TimeCount start))))))
            (setf! plus:*flash-remaining* slot remaining)
            (when (> remaining 0) (set! plus:*flash-active* #t)))
          (slots (+ slot 1))))
      (set! plus:*flash-epoch* (+ plus:*flash-epoch* 1))
      (set! plus:*flash-time* TimeCount))))

(define (plus:flash-level spot)
  (if (= (ref plus:*flash-epochs* spot) plus:*flash-epoch*)
      (ref plus:*flash-levels* spot)
      (let* ((flash (let slots ((slot 0) (brightest 0))
                      (if (= slot plus:*flash-count*)
                          brightest
                          (let ((level (truncate (/ (* (ref plus:*flash-maps* slot spot)
                                                        (ref plus:*flash-remaining* slot))
                                                     plus:*flash-tics*))))
                            (slots (+ slot 1) (max brightest level))))))
             (bright (if (zero? flash) 0
                         (clamp (truncate (/ (* 4 flash) plus:*flash-max-level*)) 1 4))))
        (setf! plus:*flash-levels* spot bright)
        (setf! plus:*flash-epochs* spot plus:*flash-epoch*)
        bright)))

(define (plus:interpolate-light cell-offset mask fractionx fractiony)
  (let ((upper (+ (ref plus:*light-cells* cell-offset)
                  (* fractionx (ref plus:*light-cells* (+ cell-offset 1)))))
        (lower (+ (ref plus:*light-cells* (+ cell-offset 2))
                  (* fractionx (ref plus:*light-cells* (+ cell-offset 3))))))
    (cond ((zero? mask) (+ upper (* fractiony (- lower upper))))
          ((= mask 9) (if (< (+ fractionx fractiony) 1) upper lower))
          ((= mask 6) (if (> fractionx fractiony) upper lower))
          (else
           (let* ((horizontal (if (or (= mask 7) (= mask 13)) fractionx (- 1 fractionx)))
                  (vertical (if (or (= mask 7) (= mask 11)) fractiony (- 1 fractiony)))
                  (weight (- 1 (* horizontal vertical))))
             (if (positive? weight)
                 (/ (+ upper (* fractiony (- lower upper))) weight)
                 (/ (+ (* 2 (ref plus:*light-cells* cell-offset))
                       (ref plus:*light-cells* (+ cell-offset 1))
                       (* 2 (ref plus:*light-cells* (+ cell-offset 2)))
                       (ref plus:*light-cells* (+ cell-offset 3)))
                    3)))))))

(define (plus:light-level level worldx worldy)
  (if plus:*active*
      (let* ((tilex (/ worldx TILEGLOBAL))
             (tiley (/ worldy TILEGLOBAL))
             (samplex (clamp (- tilex 0.5) 0 (- MAPSIZE 1)))
             (sampley (clamp (- tiley 0.5) 0 (- MAPSIZE 1)))
             (left (floor samplex))
             (top (floor sampley))
             (spot (plus:light-index left top))
             (fractionx (- samplex left))
             (fractiony (- sampley top))
             (light (plus:interpolate-light (* 4 spot) (ref plus:*light-masks* spot)
                                            fractionx fractiony))
             (dark (- (+ plus:*ambient-depth* level) (* plus:*light-step* light)))
             (bright (if plus:*flash-active*
                         (plus:flash-level
                           (plus:light-index (clamp (floor tilex) 0 (- MAPSIZE 1))
                                             (clamp (floor tiley) 0 (- MAPSIZE 1))))
                         0)))
        (max plus:*level-min* (- dark (* 16 bright))))
      0))

(define (plus:ceiling-light? shape)
  (or (= shape (+ SPR_STAT_0 4)) (= shape (+ SPR_STAT_0 14))))

(define (plus:light-emission shape)
  (cond ((= shape (+ SPR_STAT_0 3)) 1)
        ((plus:ceiling-light? shape) 2)
        (else 0)))

(define (plus:light-shape? shape)
  (> (plus:light-emission shape) 0))

(define (plus:light-factor level)
  (- 1 (/ level (if (< level 0) 120 plus:*level-max*))))

(define (plus:color-offset color)
  (* color 3))

(define (plus:rgb-set! palette color rgb)
  (let ((offset (plus:color-offset color)))
    (setf! palette offset (ref rgb 0))
    (setf! palette (+ offset 1) (ref rgb 1))
    (setf! palette (+ offset 2) (ref rgb 2))))

(define (plus:build-table factor)
  (let ((table (make-bytevector 256 0)))
    (let colors ((color 0))
      (when (< color 256)
        (let* ((offset (plus:color-offset color))
               (red (min 63 (round (* (ref gamepal offset) factor))))
               (green (min 63 (round (* (ref gamepal (+ offset 1)) factor))))
               (blue (min 63 (round (* (ref gamepal (+ offset 2)) factor)))))
          (setf! table color (plus:nearest-color (vector red green blue))))
        (colors (+ color 1))))
    table))

(define (plus:linear channel)
  (let ((value (/ channel 63)))
    (if (<= value 0.04045)
        (/ value 12.92)
        (expt (/ (+ value 0.055) 1.055) 2.4))))

(define (plus:channel-value value)
  (* 63 (if (<= value 0.0031308)
            (* value 12.92)
            (- (* 1.055 (expt value (/ 1 2.4))) 0.055))))

(define (plus:channel value)
  (round (plus:channel-value value)))

(define (plus:target color light depth channel)
  (let* ((offset (plus:color-offset color))
         (red (plus:linear (min 63 (* (ref gamepal offset) light))))
         (green (plus:linear (min 63 (* (ref gamepal (+ offset 1)) light))))
         (blue (plus:linear (min 63 (* (ref gamepal (+ offset 2)) light))))
         (luminance (+ (* 0.2126 red) (* 0.7152 green) (* 0.0722 blue)))
         (lightness (if (<= luminance (/ 216 24389))
                        (* luminance (/ 24389 27))
                        (- (* 116 (expt luminance (/ 1 3))) 16)))
         (step (min plus:*ao-step* (/ lightness 6)))
         (target (- lightness (* depth step)))
         (level (if (<= target 8)
                    (* target (/ 27 24389))
                    (expt (/ (+ target 16) 116) 3)))
         (factor (if (zero? luminance) 0 (/ level luminance))))
    (vector (channel (* red factor))
            (channel (* green factor))
            (channel (* blue factor)))))

(define (plus:ao-target color light depth)
  (plus:target color light depth plus:channel))

(define (plus:palette-error target index)
  (let* ((offset (plus:color-offset index))
         (red (- (ref target 0) (ref gamepal offset)))
         (green (- (ref target 1) (ref gamepal (+ offset 1))))
         (blue (- (ref target 2) (ref gamepal (+ offset 2)))))
    (+ (* red red) (* green green) (* blue blue))))

(define (plus:nearest-color target)
  (let search ((index 1) (best 0) (error (plus:palette-error target 0)))
    (if (= index 256)
        best
        (let ((distance (plus:palette-error target index)))
          (if (< distance error)
              (search (+ index 1) index distance)
              (search (+ index 1) best error))))))

(define (plus:cached-color target cache)
  (let ((key (+ (* (ref target 0) 4096) (* (ref target 1) 64) (ref target 2))))
    (or (ref cache key)
        (let ((color (plus:nearest-color target)))
          (setf! cache key color)
          color))))

(define (plus:mip-average colors width height nextwidth nextheight)
  (let* ((xstep (quotient width nextwidth))
         (ystep (quotient height nextheight))
         (xoffset (* (- xstep 1) height 3))
         (yoffset (* (- ystep 1) 3))
         (result (make-bytevector (* nextwidth nextheight 3) 0)))
    (let columns ((column 0))
      (when (< column nextwidth)
        (let rows ((row 0))
          (when (< row nextheight)
            (let ((source (* (+ (* column xstep height) (* row ystep)) 3))
                  (target (* (+ (* column nextheight) row) 3)))
              (let channels ((channel 0))
                (when (< channel 3)
                  (setf! result (+ target channel)
                         (round (/ (+ (ref colors (+ source channel))
                                      (ref colors (+ source channel yoffset))
                                      (ref colors (+ source channel xoffset))
                                      (ref colors (+ source channel xoffset yoffset)))
                                   4)))
                  (channels (+ channel 1)))))
            (rows (+ row 1))))
        (columns (+ column 1))))
    result))

(define (plus:mip-table colors coarse width height blend cache)
  (let ((table (make-bytevector (* width height) 0))
        (target (make-vector 3 0))
        (nextheight (max 1 (quotient height 2)))
        (weight (- plus:*mip-steps* blend)))
    (let columns ((column 0))
      (when (< column width)
        (let rows ((row 0))
          (when (< row height)
            (let ((source (* (+ (* column height) row) 3))
                  (parent (* (+ (* (quotient column 2) nextheight) (quotient row 2)) 3)))
              (let channels ((channel 0))
                (when (< channel 3)
                  (setf! target channel
                         (round (/ (+ (* (ref colors (+ source channel)) weight)
                                      (* (ref coarse (+ parent channel)) blend))
                                   plus:*mip-steps*)))
                  (channels (+ channel 1))))
              (setf! table (+ (* column height) row) (plus:cached-color target cache)))
            (rows (+ row 1))))
        (columns (+ column 1))))
    table))

(define (plus:mip-chain colors width texels cache)
  (let ((tables (make-vector (+ (* (- plus:*mip-levels* 1) plus:*mip-steps*) 1) #f)))
    (let levels ((width width) (height 64) (colors colors) (level 0))
      (let* ((nextwidth (max 1 (quotient width 2)))
             (nextheight (max 1 (quotient height 2)))
             (coarse (if (= height 1) colors
                         (plus:mip-average colors width height nextwidth nextheight))))
        (let blends ((blend 0))
          (when (< blend (if (= height 1) 1 plus:*mip-steps*))
            (setf! tables (+ (* level plus:*mip-steps*) blend)
                   (plus:wall-mip-entry
                     width height
                     (if (and texels (zero? level) (zero? blend))
                         texels
                         (plus:mip-table colors coarse width height blend cache))))
            (plus:maybe-yield)
            (blends (+ blend 1))))
        (unless (= height 1)
          (levels nextwidth nextheight coarse (+ level 1)))))
    tables))

(define (plus:build-mips cache)
  (set! plus:*mips* (make-vector PMSpriteStart #f))
  (let pages ((page 0))
    (when (< page PMSpriteStart)
      (when (PM_HasPage page)
        (let ((texels (PM_GetPage page))
              (colors (make-bytevector (* 64 64 3) 0))
              (chains (make-vector plus:*mip-levels* #f)))
          (let pixels ((pixel 0))
            (when (< pixel (* 64 64))
              (let ((source (plus:color-offset (ref texels pixel)))
                    (target (plus:color-offset pixel)))
                (let channels ((channel 0))
                  (when (< channel 3)
                    (setf! colors (+ target channel) (ref gamepal (+ source channel)))
                    (channels (+ channel 1)))))
              (pixels (+ pixel 1))))
          (let aspects ((width 64) (colors colors) (aspect 0))
            (setf! chains aspect
                   (plus:mip-chain colors width (and (zero? aspect) texels) cache))
            (unless (= width 1)
              (let ((nextwidth (quotient width 2)))
                (aspects nextwidth (plus:mip-average colors width 64 nextwidth 64) (+ aspect 1)))))
          (setf! plus:*mips* page chains)))
      (pages (+ page 1)))))

(define (plus:wall-mip page column vertical)
  (let* ((deltax (- (ref plus:*wall-x* column) viewx))
         (deltay (- (ref plus:*wall-y* column) viewy))
         (depth (max MINDIST (/ (- (* deltax viewcos) (* deltay viewsin)) TILEGLOBAL)))
         (normal (max 1 (abs (if vertical deltax deltay))))
         (footprint (/ (* 64 depth) (* TILEGLOBAL scale)))
         (horizontal (* footprint (max 1 (/ depth normal))))
         (aspect (let aspects ((ratio (/ (max 1 horizontal) (max 1 footprint))) (index 0))
                   (if (and (< index (- plus:*mip-levels* 1)) (>= ratio 2))
                       (aspects (/ ratio 2) (+ index 1))
                       index)))
         (chain (ref plus:*mips* page aspect)))
    (let levels ((height 64) (level 0) (footprint (max 1 footprint)))
      (cond ((= height 1) (ref chain (* level plus:*mip-steps*)))
            ((>= footprint 2) (levels (quotient height 2) (+ level 1) (/ footprint 2)))
            (else
              (ref chain
                   (+ (* level plus:*mip-steps*) (round (* plus:*mip-steps* (- footprint 1))))))))))

(define (plus:surface-colors)
  (if (= mapon -1)
      (vector FLOOR)
      (let ((ceiling (ceiling-color)))
        (if (= ceiling FLOOR) (vector FLOOR) (vector FLOOR ceiling)))))

(define (plus:palette-distance first second)
  (let ((first-offset (plus:color-offset first))
        (second-offset (plus:color-offset second)))
    (let ((red (- (ref gamepal first-offset) (ref gamepal second-offset)))
          (green (- (ref gamepal (+ first-offset 1)) (ref gamepal (+ second-offset 1))))
          (blue (- (ref gamepal (+ first-offset 2)) (ref gamepal (+ second-offset 2)))))
      (+ (* red red) (* green green) (* blue blue)))))

(define (plus:palette-sample target)
  (let* ((pair (plus:dither-pair target))
         (first (ref pair 0))
         (second (ref pair 1))
         (mix (ref pair 2))
         (first-error (plus:palette-error target first))
         (second-error (plus:palette-error target second))
         (nearest (if (or (< first-error second-error)
                          (and (= first-error second-error) (< first second))) first second))
         (distance (plus:palette-distance first second))
         (pixel-error (+ (* (- 1 mix) first-error) (* mix second-error)))
         (variance (* mix (- 1 mix) distance))
         (limit (+ distance (/ (max 0 (- pixel-error variance)) plus:*dither-contrast*))))
    (plus:palette-sample-entry nearest (min first-error second-error) limit pixel-error)))

(define (plus:prepare-palette! surfaces ramp count targets colors samples weights)
  (let prepare ((index 0))
    (when (< index count)
      (let* ((shade (remainder index plus:*level-count*))
             (layer (remainder (quotient index plus:*level-count*) (vector-length plus:*ao-depths*)))
             (depth (ref plus:*ao-depths* layer))
             (color (ref surfaces (quotient index ramp)))
             (target (plus:target color (plus:light-factor (+ shade plus:*level-min*))
                                  depth plus:channel-value))
             (rounded (vector (round (ref target 0)) (round (ref target 1)) (round (ref target 2)))))
        (unless (zero? (plus:palette-error rounded (plus:nearest-color rounded)))
          (let ((brightness (/ (+ (* 54 (ref target 0)) (* 183 (ref target 1))
                                   (* 19 (ref target 2))) 256)))
            (setf! targets index target)
            (setf! colors index rounded)
            (setf! samples index (plus:palette-sample target))
            (setf! weights index (/ 1 (sqrt (+ brightness 8)))))))
      (plus:maybe-yield)
      (prepare (+ index 1)))))

(define (plus:best-palette-sample-index samples weights count)
  (let search ((index 0) (best #f) (error 0))
    (cond ((= index count) best)
          ((not (ref samples index)) (search (+ index 1) best error))
          (else
           (let ((score (* (ref weights index) (ref (ref samples index) 'pixel-error))))
             (if (or (not best) (> score error))
                 (search (+ index 1) index score)
                 (search (+ index 1) best error)))))))

(define (plus:update-palette-samples! targets colors samples count color)
  (let update ((index 0))
    (when (< index count)
      (let ((sample (ref samples index)))
        (when sample
          (cond ((zero? (plus:palette-error (ref colors index) color))
                 (setf! samples index #f))
                ((or (<= (plus:palette-error (ref targets index) color) (ref sample 'error))
                     (<= (plus:palette-distance color (ref sample 'nearest)) (ref sample 'limit)))
                 (setf! samples index (plus:palette-sample (ref targets index)))))))
      (plus:maybe-yield)
      (update (+ index 1)))))

(define (plus:build-palette surfaces)
  (let* ((ramp (* plus:*level-count* (vector-length plus:*ao-depths*)))
         (count (* (vector-length surfaces) ramp))
         (targets (make-vector count #f))
         (colors (make-vector count #f))
         (samples (make-vector count #f))
         (weights (make-vector count 0))
         (base (vector (ref gamepal 0) (ref gamepal 1) (ref gamepal 2))))
    (let slots ((slot 0))
      (when (< slot (vector-length plus:*palette-slots*))
        (plus:rgb-set! gamepal (ref plus:*palette-slots* slot) base)
        (slots (+ slot 1))))

    (plus:prepare-palette! surfaces ramp count targets colors samples weights)
    (let slots ((slot 0))
      (when (< slot (vector-length plus:*palette-slots*))
        (let ((best (plus:best-palette-sample-index samples weights count)))
          (when best
            (let ((color (ref plus:*palette-slots* slot)))
              (plus:rgb-set! gamepal color (ref colors best))
              (plus:update-palette-samples! targets colors samples count color))
            (slots (+ slot 1))))))))

(define (plus:build-ao-colors depth)
  (let ((table (make-bytevector 256 0)))
    (let colors ((color 0))
      (when (< color 256)
        (setf! table color (plus:nearest-color (plus:ao-target color 1 depth)))
        (colors (+ color 1))))
    table))

(define (plus:build-ao-shades depth)
  (let ((dark (plus:build-ao-colors depth))
        (shades (make-vector plus:*shade-count* 0)))
    (let levels ((level 0))
      (when (< level plus:*shade-count*)
        (let ((table (make-bytevector 256 0))
              (lit (ref plus:*shades* level)))
          (let colors ((color 0))
            (when (< color 256)
              (setf! table color (ref dark (ref lit color)))
              (colors (+ color 1))))
          (setf! shades level table))
        (plus:maybe-yield)
        (levels (+ level 1))))
    shades))

(define (plus:build-ao)
  (set! plus:*ao-shades* (plus:build-ao-shades (ref plus:*ao-depths* 1)))
  (set! plus:*corner-shades* (plus:build-ao-shades (ref plus:*ao-depths* 2)))
  (set! plus:*pillar-shades* (make-vector 9 (ref plus:*shades* (plus:shade 0))))
  (let levels ((level 1))
    (when (< level (vector-length plus:*pillar-shades*))
      (setf! plus:*pillar-shades* level (plus:build-ao-colors (/ level 4)))
      (plus:maybe-yield)
      (levels (+ level 1)))))

(define (plus:build-shades)
  (let ((identity (make-bytevector 256 0)))
    (let loop ((index 0))
      (when (< index 256)
        (let* ((offset (plus:color-offset index))
               (luma (truncate (/ (+ (* 54 (ref gamepal offset))
                                       (* 183 (ref gamepal (+ offset 1)))
                                       (* 19 (ref gamepal (+ offset 2))))
                                    256))))
          (setf! identity index index)
          (setf! plus:*luma* index luma)
          (setf! plus:*emissive* index (if (>= luma plus:*emissive-luma*) 1 0)))
        (loop (+ index 1))))
    (setf! plus:*shades* (plus:shade 0) identity))
  (let shades ((shade 0))
    (when (< shade plus:*shade-count*)
      (let ((level (+ (* shade plus:*shade-step*) plus:*level-min*)))
        (unless (zero? level)
          (setf! plus:*shades* shade (plus:build-table (plus:light-factor level)))))
      (plus:maybe-yield)
      (shades (+ shade 1))))
  (plus:build-ao))

(define (plus:in-map? tilex tiley)
  (and (>= tilex 0) (< tilex MAPSIZE) (>= tiley 0) (< tiley MAPSIZE)))

(define (plus:door-tile? tile)
  (and (>= tile 128) (< tile 192)))

(define (plus:bit-set? value bits)
  (not (zero? (bitwise-and value bits))))

(define (plus:pushwall-tile? tile)
  (and (>= tile 128) (plus:bit-set? tile 64)))

(define (plus:secret-tile? tilex tiley)
  (not (zero? (ref plus:*secret-map* (plus:light-index tilex tiley)))))

(define (plus:light-path-tile? tilex tiley)
  (and (plus:in-map? tilex tiley)
       (let ((tile (tileat tilex tiley)))
         (or (zero? tile) (plus:door-tile? tile) (plus:secret-tile? tilex tiley)))))

(define (plus:light-passable? tilex tiley)
  (plus:light-path-tile? tilex tiley))

(define (plus:box-distance-squared worldx worldy left top right bottom)
  (let ((dx (max 0 (- left worldx) (- worldx right)))
        (dy (max 0 (- top worldy) (- worldy bottom))))
    (+ (* dx dx) (* dy dy))))

(define (plus:wall-distance worldx worldy tilex tiley)
  (let ((tile (tileat tilex tiley))
        (limit (* plus:*ao-width* plus:*ao-width*)))
    (cond
      ((zero? tile) limit)
      ((and (> pwallstate 0)
            (or (and (= tilex pwallx) (= tiley pwally))
                (and (= tilex (+ pwallx (dir-dx pwalldir)))
                     (= tiley (+ pwally (dir-dy pwalldir))))))
       (let ((left (+ (* pwallx TILEGLOBAL) (* pwallpos 1024 (dir-dx pwalldir))))
             (top (+ (* pwally TILEGLOBAL) (* pwallpos 1024 (dir-dy pwalldir)))))
         (plus:box-distance-squared worldx worldy left top (+ left TILEGLOBAL) (+ top TILEGLOBAL))))
      ((plus:door-tile? tile)
       (let* ((door (bitwise-and tile 127))
              (position (ref doorposition door))
              (left (* tilex TILEGLOBAL))
              (top (* tiley TILEGLOBAL)))
         (if (= position 65535)
             limit
             (if (ref doorvertical door)
                 (plus:box-distance-squared worldx worldy (+ left 32768) (+ top position)
                                            (+ left 32768) (+ top TILEGLOBAL))
                 (plus:box-distance-squared worldx worldy (+ left position) (+ top 32768)
                                            (+ left TILEGLOBAL) (+ top 32768))))))
      (else
       (plus:box-distance-squared worldx worldy (* tilex TILEGLOBAL) (* tiley TILEGLOBAL)
                                  (* (+ tilex 1) TILEGLOBAL) (* (+ tiley 1) TILEGLOBAL))))))

(define (plus:ao-distance-squared worldx worldy)
  (let ((left (max 0 (arithmetic-shift (- worldx plus:*ao-width*) -16)))
        (right (min (- MAPSIZE 1) (arithmetic-shift (+ worldx plus:*ao-width*) -16)))
        (top (max 0 (arithmetic-shift (- worldy plus:*ao-width*) -16)))
        (bottom (min (- MAPSIZE 1) (arithmetic-shift (+ worldy plus:*ao-width*) -16))))
    (let columns ((tilex left) (distance (* plus:*ao-width* plus:*ao-width*)))
      (if (or (> tilex right) (zero? distance))
          distance
          (columns (+ tilex 1)
                   (let rows ((tiley top) (nearest distance))
                     (if (or (> tiley bottom) (zero? nearest))
                         nearest
                         (rows (+ tiley 1)
                               (min nearest (plus:wall-distance worldx worldy tilex tiley))))))))))

(define (plus:corner-wall? tilex tiley)
  (and (plus:in-map? tilex tiley)
       (let ((tile (tileat tilex tiley)))
         (and (> tile 0) (< tile 128)))
       (not (and (> pwallstate 0)
                 (= tilex (+ pwallx (dir-dx pwalldir)))
                 (= tiley (+ pwally (dir-dy pwalldir)))))))

(define (plus:corner? worldx worldy)
  (let* ((tilex (arithmetic-shift worldx -16))
         (tiley (arithmetic-shift worldy -16))
         (offsetx (- worldx (* tilex TILEGLOBAL)))
         (offsety (- worldy (* tiley TILEGLOBAL)))
         (dx (min offsetx (- TILEGLOBAL offsetx)))
         (dy (min offsety (- TILEGLOBAL offsety))))
    (and (plus:in-map? tilex tiley)
         (>= dx 0) (< dx plus:*ao-width*) (>= dy 0) (< dy plus:*ao-width*)
         (< (+ (* dx dx) (* dy dy)) (* plus:*ao-width* plus:*ao-width*))
         (zero? (tileat tilex tiley))
         (plus:corner-wall? (+ tilex (if (< offsetx (/ TILEGLOBAL 2)) -1 1)) tiley)
         (plus:corner-wall? tilex (+ tiley (if (< offsety (/ TILEGLOBAL 2)) -1 1))))))

(define (plus:ao-layer worldx worldy edge)
  (cond ((< (plus:ao-distance-squared worldx worldy) (* plus:*ao-width* plus:*ao-width*))
         (if (plus:corner? worldx worldy) 2 1))
        (edge 1)
        (else 0)))

(define (plus:ao level worldx worldy edge)
  (if plus:*active*
      (let ((shade (plus:shade level))
            (layer (plus:ao-layer worldx worldy edge)))
        (cond ((= layer 2) (ref plus:*corner-shades* shade))
              ((= layer 1) (ref plus:*ao-shades* shade))
              (else (ref plus:*shades* shade))))
      (ref plus:*shades* (plus:shade 0))))

(define (plus:check-keys)
  (when plus:*requested*
    (let ((pressed (and (or (ref Keyboard sc_LShift) (ref Keyboard sc_RShift))
                        (ref Keyboard sc_P))))
      (when (and pressed (not plus:*key*))
        (set! plus:*active* (not plus:*active*)))
      (set! plus:*key* pressed))))

(define (plus:secret-transmission spot)
  (let ((tilex (remainder spot MAPSIZE))
        (tiley (quotient spot MAPSIZE)))
    (cond ((and (> pwallstate 0) (= tilex pwallx) (= tiley pwally)) (/ pwallpos 64))
          ((zero? (tileat tilex tiley)) 1)
          (else 0))))

(define (plus:requirement-transmission requirement)
  (if (< requirement MAXDOORS)
      (/ (ref doorposition requirement) 65535)
      (ref plus:*secret-transmissions* (- requirement MAXDOORS))))

(define (plus:trace-light fromx fromy tox toy)
  (let ((dx (abs (- tox fromx)))
        (dy (abs (- toy fromy)))
        (stepx (if (< fromx tox) 1 -1))
        (stepy (if (< fromy toy) 1 -1)))
    (let ray ((tilex fromx) (tiley fromy) (crossx dy) (crossy dx) (requirements '()))
      (and (plus:light-path-tile? tilex tiley)
           (let* ((tile (tileat tilex tiley))
                  (requirement (cond ((plus:door-tile? tile) (bitwise-and tile 127))
                                     ((plus:secret-tile? tilex tiley)
                                      (+ MAXDOORS (plus:light-index tilex tiley)))
                                     (else #f)))
                  (path (if requirement (cons requirement requirements) requirements)))
             (cond ((and (= tilex tox) (= tiley toy)) path)
                   ((< crossx crossy) (ray (+ tilex stepx) tiley (+ crossx (* 2 dy)) crossy path))
                   ((> crossx crossy) (ray tilex (+ tiley stepy) crossx (+ crossy (* 2 dx)) path))
                   (else
                    (and (plus:light-path-tile? (+ tilex stepx) tiley)
                         (plus:light-path-tile? tilex (+ tiley stepy))
                         (ray (+ tilex stepx) (+ tiley stepy)
                              (+ crossx (* 2 dy)) (+ crossy (* 2 dx)) path)))))))))

(define (plus:path-transmission requirements)
  (if (null? requirements)
      1
      (* (plus:requirement-transmission (car requirements))
         (plus:path-transmission (cdr requirements)))))

(define (plus:light-value spot)
  (let scan ((paths (ref plus:*light-paths* spot)) (light (ref plus:*light-base* spot)))
    (if (null? paths)
        light
        (let* ((path (car paths))
               (level (* (ref path 0) (plus:path-transmission (ref path 1)))))
          (scan (cdr paths) (max level light))))))

(define (plus:build-light lightx lighty radius levels)
  (let ((left (max 0 (- lightx radius)))
        (right (min (- MAPSIZE 1) (+ lightx radius)))
        (top (max 0 (- lighty radius)))
        (bottom (min (- MAPSIZE 1) (+ lighty radius)))
        (limit (* radius radius))
        (falloff (/ levels radius)))
    (let rows ((tiley top))
      (when (<= tiley bottom)
        (let columns ((tilex left))
          (when (<= tilex right)
            (let* ((dx (- tilex lightx))
                   (dy (- tiley lighty))
                   (distance (+ (* dx dx) (* dy dy))))
              (when (and (< distance limit) (plus:light-path-tile? tilex tiley))
                (let ((requirements (plus:trace-light lightx lighty tilex tiley)))
                  (when requirements
                    (let ((spot (plus:light-index tilex tiley))
                          (level (- levels (* falloff (sqrt distance)))))
                      (if (null? requirements)
                          (setf! plus:*light-base* spot (max level (ref plus:*light-base* spot)))
                          (setf! plus:*light-paths* spot
                                 (cons (tuple level requirements) (ref plus:*light-paths* spot)))))))))
            (columns (+ tilex 1))))
        (rows (+ tiley 1))))))

(define (plus:clear-map! map)
  (let clear ((index 0))
    (when (< index (* MAPSIZE MAPSIZE))
      (setf! map index 0)
      (clear (+ index 1)))))

(define (plus:cell-value samples mask corner)
  (if (plus:bit-set? mask (arithmetic-shift 1 corner))
      (ref samples corner)
      (let* ((across (bitwise-xor corner 1))
             (along (bitwise-xor corner 2))
             (diagonal (bitwise-xor corner 3))
             (horizontal (and (plus:bit-set? mask (arithmetic-shift 1 across)) (ref samples across)))
             (vertical (and (plus:bit-set? mask (arithmetic-shift 1 along)) (ref samples along))))
        (cond ((and horizontal vertical) (/ (+ horizontal vertical) 2))
              (horizontal horizontal)
              (vertical vertical)
              ((plus:bit-set? mask (arithmetic-shift 1 diagonal)) (ref samples diagonal))
              (else 0)))))

(define (plus:build-light-cell spot)
  (let* ((samples plus:*light-samples*)
         (left (remainder spot MAPSIZE))
         (top (quotient spot MAPSIZE))
         (right (min (- MAPSIZE 1) (+ left 1)))
         (bottom (min (- MAPSIZE 1) (+ top 1)))
         (cell (* 4 spot))
         (mask (+ (if (plus:light-passable? left top) 1 0)
                  (if (plus:light-passable? right top) 2 0)
                  (if (plus:light-passable? left bottom) 4 0)
                  (if (plus:light-passable? right bottom) 8 0))))
    (setf! samples 0 (ref plus:*light-map* (plus:light-index left top)))
    (setf! samples 1 (ref plus:*light-map* (plus:light-index right top)))
    (setf! samples 2 (ref plus:*light-map* (plus:light-index left bottom)))
    (setf! samples 3 (ref plus:*light-map* (plus:light-index right bottom)))
    (let* ((masked (if (or (= mask 6) (= mask 7) (= mask 9) (= mask 11) (= mask 13) (= mask 14)) mask 0))
           (upper (cond ((= masked 6) (ref samples 1))
                        ((> masked 0) (ref samples 0))
                        (else (plus:cell-value samples mask 0))))
           (lower (cond ((= masked 9) (ref samples 3))
                        ((> masked 0) (ref samples 2))
                        (else (plus:cell-value samples mask 2))))
           (upper-right (cond ((or (= masked 6) (= masked 9)) upper)
                              ((> masked 0) (ref samples 1))
                              (else (plus:cell-value samples mask 1))))
           (lower-right (cond ((or (= masked 6) (= masked 9)) lower)
                              ((> masked 0) (ref samples 3))
                              (else (plus:cell-value samples mask 3)))))
      (setf! plus:*light-masks* spot masked)
      (setf! plus:*light-cells* cell upper)
      (setf! plus:*light-cells* (+ cell 1) (- upper-right upper))
      (setf! plus:*light-cells* (+ cell 2) lower)
      (setf! plus:*light-cells* (+ cell 3) (- lower-right lower)))))

(define (plus:build-light-cells)
  (let cells ((spot 0))
    (when (< spot (* MAPSIZE MAPSIZE))
      (plus:build-light-cell spot)
      (cells (+ spot 1)))))

(define (plus:watch-light-path spot path watched)
  (for-each
    (lambda (requirement)
      (unless (= (ref watched requirement) spot)
        (setf! watched requirement spot)
        (setf! plus:*light-watch* requirement (cons spot (ref plus:*light-watch* requirement)))))
    (ref path 1)))

(define (plus:watch-vector spots)
  (let ((watch (make-vector (length spots) 0)))
    (let fill ((index 0) (spots spots))
      (if (null? spots)
          watch
          (begin
            (setf! watch index (car spots))
            (fill (+ index 1) (cdr spots)))))))

(define (plus:collect-secrets!)
  (let scan ((spot 0) (secrets '()))
    (if (= spot (* MAPSIZE MAPSIZE))
        (let ((spots (plus:watch-vector secrets)))
          (set! plus:*secret-spots* spots)
          (let initialize ((index 0))
            (when (< index (vector-length spots))
              (let ((secret (ref spots index)))
                (setf! plus:*secret-transmissions* secret (plus:secret-transmission secret)))
              (initialize (+ index 1)))))
        (if (= (maptile 1 spot) PUSHABLETILE)
            (begin
              (setf! plus:*secret-map* spot 1)
              (scan (+ spot 1) (cons spot secrets)))
            (scan (+ spot 1) secrets)))))

(define (plus:reset-lights!)
  (plus:clear-map! plus:*light-base*)
  (plus:clear-map! plus:*light-dirty*)
  (plus:clear-map! plus:*secret-map*)
  (set! plus:*light-watch* (make-vector (+ MAXDOORS (* MAPSIZE MAPSIZE)) '()))
  (set! plus:*secret-spots* #())
  (set! plus:*light-count* 0)
  (let doors ((door 0))
    (when (< door MAXDOORS)
      (setf! plus:*light-positions* door (ref doorposition door))
      (doors (+ door 1))))
  (let clear ((spot 0))
    (when (< spot (* MAPSIZE MAPSIZE))
      (setf! plus:*light-paths* spot '())
      (clear (+ spot 1)))))

(define (plus:collect-lights!)
  (let lights ((index 0))
    (when (< index statcount)
      (when (plus:light-shape? (ref stat-shape index))
        (plus:build-light (ref stat-tilex index) (ref stat-tiley index) plus:*light-radius*
                          (if (= (ref stat-shape index) (+ SPR_STAT_0 4))
                              plus:*chandelier-levels* plus:*light-levels*)))
      (lights (+ index 1)))))

(define (plus:finalize-light-watch! requirement)
  (setf! plus:*light-watch* requirement
         (plus:watch-vector (ref plus:*light-watch* requirement))))

(define (plus:finalize-lights!)
  (let ((watched (make-vector (vector-length plus:*light-watch*) -1)))
    (let points ((spot 0))
      (when (< spot (* MAPSIZE MAPSIZE))
        (setf! plus:*light-paths* spot
               (fold (lambda (path kept)
                       (if (<= (ref path 0) (ref plus:*light-base* spot))
                           kept
                           (begin
                             (plus:watch-light-path spot path watched)
                             (cons path kept))))
                     '() (ref plus:*light-paths* spot)))
        (setf! plus:*light-map* spot (plus:light-value spot))
        (points (+ spot 1)))))
  (let doors ((door 0))
    (when (< door MAXDOORS)
      (plus:finalize-light-watch! door)
      (doors (+ door 1))))
  (let secrets ((index 0))
    (when (< index (vector-length plus:*secret-spots*))
      (plus:finalize-light-watch! (+ MAXDOORS (ref plus:*secret-spots* index)))
      (secrets (+ index 1))))
  (plus:build-light-cells))

(define (plus:build-lights)
  (plus:reset-lights!)
  (plus:collect-secrets!)
  (plus:collect-lights!)
  (plus:finalize-lights!))

(define (plus:dirty-light spot flags)
  (let ((current (ref plus:*light-dirty* spot)))
    (when (zero? current)
      (setf! plus:*light-queue* plus:*light-count* spot)
      (set! plus:*light-count* (+ plus:*light-count* 1)))
    (setf! plus:*light-dirty* spot (bitwise-ior current flags))))

(define (plus:dirty-cells spot)
  (plus:dirty-light spot 2)
  (when (> (remainder spot MAPSIZE) 0)
    (plus:dirty-light (- spot 1) 2))
  (when (>= spot MAPSIZE)
    (plus:dirty-light (- spot MAPSIZE) 2)
    (when (> (remainder spot MAPSIZE) 0)
      (plus:dirty-light (- spot MAPSIZE 1) 2))))

(define (plus:update-dirty-lights!)
  (let points ((head 0))
    (when (< head plus:*light-count*)
      (let ((spot (ref plus:*light-queue* head)))
        (when (plus:bit-set? (ref plus:*light-dirty* spot) 1)
          (let ((light (plus:light-value spot)))
            (unless (= light (ref plus:*light-map* spot))
              (setf! plus:*light-map* spot light)
              (plus:dirty-cells spot)))))
      (points (+ head 1)))))

(define (plus:rebuild-dirty-light-cells!)
  (let cells ((head 0))
    (when (< head plus:*light-count*)
      (let ((spot (ref plus:*light-queue* head)))
        (when (plus:bit-set? (ref plus:*light-dirty* spot) 2)
          (plus:build-light-cell spot))
        (setf! plus:*light-dirty* spot 0))
      (cells (+ head 1)))))

(define (plus:dirty-light-watch requirement)
  (let ((spots (ref plus:*light-watch* requirement)))
    (let watch ((index 0))
      (when (< index (vector-length spots))
        (plus:dirty-light (ref spots index) 1)
        (watch (+ index 1))))))

(define (plus:update-lights)
  (when plus:*active*
    (let doors ((door 0))
      (when (< door doornum)
        (let ((position (ref doorposition door)))
          (unless (= position (ref plus:*light-positions* door))
            (plus:dirty-light-watch door)
            (setf! plus:*light-positions* door position)))
        (doors (+ door 1))))
    (let secrets ((index 0))
      (when (< index (vector-length plus:*secret-spots*))
        (let* ((spot (ref plus:*secret-spots* index))
               (transmission (plus:secret-transmission spot)))
          (unless (= transmission (ref plus:*secret-transmissions* spot))
            (plus:dirty-light-watch (+ MAXDOORS spot))
            (setf! plus:*secret-transmissions* spot transmission)))
        (secrets (+ index 1))))
    (plus:update-dirty-lights!)
    (plus:rebuild-dirty-light-cells!)
    (set! plus:*light-count* 0)))

(define (plus:flash-at tilex tiley)
  (when plus:*active*
    (let ((flashmap (ref plus:*flash-maps* plus:*flash-next*))
          (queue (make-vector (* MAPSIZE MAPSIZE) 0))
          (distance (make-bytevector (* MAPSIZE MAPSIZE) 255))
          (tail 1))
      (plus:clear-map! flashmap)
      (setf! queue 0 (plus:light-index tilex tiley))
      (setf! distance (plus:light-index tilex tiley) 0)

      (let ((max-distance
             (let flood ((head 0) (farthest 0))
               (if (= head tail)
                   farthest
                   (let* ((spot (ref queue head))
                          (tilex (remainder spot MAPSIZE))
                          (tiley (quotient spot MAPSIZE))
                          (steps (ref distance spot)))
                     (let visit ((direction 0))
                       (when (< direction 4)
                         (let ((nextx (+ tilex (ref plus:*neighbors* direction 0)))
                               (nexty (+ tiley (ref plus:*neighbors* direction 1))))
                           (when (plus:light-passable? nextx nexty)
                             (let ((next (plus:light-index nextx nexty)))
                               (when (> (ref distance next) (+ steps 1))
                                 (setf! distance next (+ steps 1))
                                 (setf! queue tail next)
                                 (set! tail (+ tail 1))))))
                         (visit (+ direction 1))))
                     (flood (+ head 1) (max farthest steps)))))))
        (let stamp ((index 0))
          (when (< index tail)
            (let* ((spot (ref queue index))
                   (tilex (remainder spot MAPSIZE))
                   (tiley (quotient spot MAPSIZE))
                   (steps (ref distance spot))
                   (level (if (zero? max-distance)
                              plus:*flash-max-level*
                              (max 1 (- plus:*flash-max-level*
                                        (truncate (/ (* plus:*flash-max-level* steps) max-distance)))))))
              (setf! flashmap spot level)
              (let walls ((direction 0))
                (when (< direction 4)
                  (let ((nextx (+ tilex (ref plus:*neighbors* direction 0)))
                        (nexty (+ tiley (ref plus:*neighbors* direction 1))))
                    (when (and (plus:in-map? nextx nexty) (not (zero? (tileat nextx nexty))))
                      (let ((next (plus:light-index nextx nexty)))
                        (setf! flashmap next (max level (ref flashmap next))))))
                  (walls (+ direction 1)))))
            (stamp (+ index 1)))))

      (setf! plus:*flash-starts* plus:*flash-next* TimeCount)
      (set! plus:*flash-time* #f)
      (set! plus:*flash-next* (remainder (+ plus:*flash-next* 1) plus:*flash-count*)))))

(define (plus:enemy-shape? shape)
  (or (and (>= shape SPR_GRD_S_1) (< shape SPR_HYPO1))
      (and (>= shape SPR_FAKE_W1) (< shape SPR_FIRE1))
      (and (>= shape SPR_FAKE_DIE1) (< shape SPR_ROCKET_1))
      (and (>= shape SPR_GRETEL_W1) (<= shape SPR_FAT_DEAD))))

(define (plus:for-each-sprite-post page visit)
  (let ((leftpix (readu16 page 0))
        (rightpix (readu16 page 2)))
    (let columns ((column leftpix))
      (when (<= column rightpix)
        (let posts ((offset (readu16 page (+ 4 (* (- column leftpix) 2)))))
          (let ((endpixel (readu16 page offset)))
            (when (and (positive? endpixel) (visit column offset endpixel))
              (posts (+ offset 6)))))
        (columns (+ column 1))))))

(define (plus:crop-sprite shape)
  (let* ((source (PM_GetPage (+ PMSpriteStart shape)))
         (page (bytevector-copy source 0 (bytevector-length source)))
         (limit (* 32 2)))
    (plus:for-each-sprite-post
      page
      (lambda (column offset endpixel)
        (let ((startpixel (readu16 page (+ offset 4))))
          (setf! page offset (if (>= startpixel limit) 0 (min endpixel limit)))
          (setf! page (+ offset 1) 0)
          (< startpixel limit))))
    page))

(define (plus:build-sprites)
  (set! plus:*sprites* (make-vector (- PMSoundStart PMSpriteStart) #f))
  (let shapes ((shape 0))
    (when (< shape (vector-length plus:*sprites*))
      (when (and (plus:ceiling-light? shape) (PM_HasPage (+ PMSpriteStart shape)))
        (setf! plus:*sprites* shape (plus:crop-sprite shape)))
      (shapes (+ shape 1)))))

(define (plus:sprite-image page)
  (let ((image (make-vector (* 64 64 4) 0)))
    (plus:for-each-sprite-post
      page
      (lambda (column offset endpixel)
        (let ((topofs (readi16 page (+ offset 2)))
              (startpixel (readu16 page (+ offset 4))))
          (let rows ((row (quotient startpixel 2)))
            (when (< row (quotient endpixel 2))
              (let ((source (* (ref page (+ topofs row)) 3))
                    (target (* (+ (* column 64) row) 4)))
                (let channels ((channel 0))
                  (when (< channel 3)
                    (setf! image (+ target channel) (ref gamepal (+ source channel)))
                    (channels (+ channel 1))))
                (setf! image (+ target 3) 1))
              (rows (+ row 1))))
          #t)))
    image))

(define (plus:downsample-sprite-image image size)
  (let* ((width (quotient size 2))
         (result (make-vector (* width width 4) 0)))
    (let columns ((column 0))
      (when (< column width)
        (let rows ((row 0))
          (when (< row width)
            (let ((source (* (+ (* column size) row) 8))
                  (target (* (+ (* column width) row) 4)))
              (let channels ((channel 0))
                (when (< channel 4)
                  (setf! result (+ target channel)
                         (/ (+ (ref image (+ source channel))
                               (ref image (+ source channel 4))
                               (ref image (+ source channel (* size 4)))
                               (ref image (+ source channel (* size 4) 4))) 4))
                  (channels (+ channel 1)))))
            (rows (+ row 1))))
        (columns (+ column 1))))
    result))

(define (plus:build-sprite-mip image size cache)
  (let ((colors (make-bytevector (* size size) 0))
        (coverage (make-vector (* size size) 0))
        (target (make-vector 3 0)))
    (let pixels ((pixel 0))
      (when (< pixel (* size size))
        (let* ((source (* pixel 4))
               (alpha (ref image (+ source 3))))
          (setf! coverage pixel alpha)
          (when (> alpha 0)
            (let channels ((channel 0))
              (when (< channel 3)
                (setf! target channel (round (/ (ref image (+ source channel)) alpha)))
                (channels (+ channel 1))))
            (setf! colors pixel (plus:cached-color target cache))))
        (pixels (+ pixel 1))))
    (plus:sprite-mip-entry size colors coverage)))

(define (plus:build-sprite-mips cache)
  (set! plus:*sprite-mips* (make-vector (vector-length plus:*sprites*) #f))
  (let shapes ((shape 0))
    (when (< shape (vector-length plus:*sprites*))
      (when (PM_HasPage (+ PMSpriteStart shape))
        (let ((page (or (ref plus:*sprites* shape) (PM_GetPage (+ PMSpriteStart shape))))
              (mips (make-vector plus:*mip-levels* #f)))
          (let levels ((image (plus:sprite-image page)) (size 64) (level 0))
            (setf! mips level (plus:build-sprite-mip image size cache))
            (unless (= size 1)
              (levels (plus:downsample-sprite-image image size) (quotient size 2) (+ level 1))))
          (setf! plus:*sprite-mips* shape mips)))
      (plus:maybe-yield)
      (shapes (+ shape 1)))))

(define (plus:build-blends)
  (set! plus:*blends* (make-bytevector (* 32 32 32) 0))
  (let ((target (make-vector 3 0)))
    (let colors ((color 0))
      (when (< color (bytevector-length plus:*blends*))
        (setf! target 0 (/ (* (quotient color 1024) 63) 31))
        (setf! target 1 (/ (* (modulo (quotient color 32) 32) 63) 31))
        (setf! target 2 (/ (* (modulo color 32) 63) 31))
        (setf! plus:*blends* color (plus:nearest-color target))
        (when (zero? (modulo color 128)) (plus:maybe-yield))
        (colors (+ color 1))))))

(define (plus:blend-sprite first second firstweight secondweight background)
  (let ((first (* first 3))
        (second (* second 3))
        (background (* background 3))
        (remaining (- 1 (+ firstweight secondweight))))
    (let channels ((channel 0) (key 0))
      (if (= channel 3)
          (ref plus:*blends* key)
          (let ((value (+ (* (ref gamepal (+ first channel)) firstweight)
                          (* (ref gamepal (+ second channel)) secondweight)
                          (* (ref gamepal (+ background channel)) remaining))))
            (channels (+ channel 1) (+ (* key 32) (round (/ (* value 31) 63)))))))))

(define (plus:scale-sprite screenx shape height rows top shade emissive)
  (let* ((level (let levels ((size 64) (level 0) (footprint (/ 64 rows)))
                  (if (and (> size 1) (>= footprint 2))
                      (levels (quotient size 2) (+ level 1) (/ footprint 2))
                      level)))
         (fine (ref plus:*sprite-mips* shape level))
         (coarse (ref plus:*sprite-mips* shape (min (- plus:*mip-levels* 1) (+ level 1))))
         (size (ref fine 'size))
         (finecolors (ref fine 'colors))
         (finecoverage (ref fine 'coverage))
         (coarsecolors (ref coarse 'colors))
         (coarsecoverage (ref coarse 'coverage))
         (coarsesize (ref coarse 'size))
         (blend (min 1 (- (/ size rows) 1)))
         (weight (- 1 blend))
         (left (- screenx (quotient rows 2)))
         (limit (min (+ left rows) viewwidth))
         (start (max top 0))
         (end (min (+ top rows) viewheight)))
    (let columns ((column (max left 0)))
      (when (< column limit)
        (when (< (ref plus:*wall-height* column) height)
          (let* ((sourcex (truncate (/ (* (+ (- column left) 0.5) size) rows)))
                 (sourcebase (* sourcex size))
                 (parentbase (* (quotient sourcex 2) coarsesize)))
            (let scan ((row start))
              (when (< row end)
                (let* ((sourcey (truncate (/ (* (+ (- row top) 0.5) size) rows)))
                       (source (+ sourcebase sourcey))
                       (parent (+ parentbase (quotient sourcey 2)))
                       (firstweight (* (ref finecoverage source) weight))
                       (secondweight (* (ref coarsecoverage parent) blend)))
                  (when (> (+ firstweight secondweight) 0)
                    (let* ((first (plus:shaded-sprite-color (ref finecolors source) shade emissive))
                           (second (plus:shaded-sprite-color (ref coarsecolors parent) shade emissive))
                           (pixel (+ (* (+ row viewtop) screenwidth) viewleft column)))
                      (setf! framebuffer pixel
                             (if (or (= firstweight 1)
                                     (and (= first second) (= (+ firstweight secondweight) 1)))
                                 first
                                 (plus:blend-sprite first second firstweight secondweight
                                                    (ref framebuffer pixel))))
                      (set! sprite-pixels (+ sprite-pixels 1)))))
                (scan (+ row 1))))))
        (columns (+ column 1))))))

(define (plus:shape-bounds shape top bottom)
  (let ((page (PM_GetPage (+ PMSpriteStart shape)))
        (first 64)
        (last -1))
    (plus:for-each-sprite-post
      page
      (lambda (column offset endpixel)
        (when (and (> endpixel (* top 2)) (< (readu16 page (+ offset 4)) (* bottom 2)))
          (set! first (min first column))
          (set! last (max last column)))
        #t))
    (and (<= first last) (tuple first (+ last 1)))))

(define (plus:body-bounds shape)
  (or (plus:shape-bounds shape 60 64)
      (let ((page (PM_GetPage (+ PMSpriteStart shape)))
            (bottom 0))
        (plus:for-each-sprite-post
          page
          (lambda (column offset endpixel)
            (set! bottom (max bottom (quotient endpixel 2)))
            #t))
        (and (positive? bottom) (plus:shape-bounds shape (max 0 (- bottom 4)) bottom)))))

(define (plus:build-contacts)
  (let ((count (- PMSoundStart PMSpriteStart)))
    (set! plus:*feet* (make-vector count #f))
    (set! plus:*mounts* (make-vector count #f)))
  (let shapes ((shape 0))
    (when (< shape (vector-length plus:*feet*))
      (when (and (not (= shape plus:*pillar*)) (PM_HasPage (+ PMSpriteStart shape)))
        (let* ((offset (- shape SPR_STAT_0))
               (contact (if (and (>= offset 0) (< offset (vector-length plus:*contacts*)))
                            (ref plus:*contacts* offset)
                            'none)))
          (when (or (eq? contact 'floor) (eq? contact 'both) (plus:enemy-shape? shape))
            (setf! plus:*feet* shape (plus:body-bounds shape)))
          (when (or (eq? contact 'ceiling) (eq? contact 'both))
            (setf! plus:*mounts* shape (plus:shape-bounds shape 0 3)))))
      (shapes (+ shape 1)))))

(define (plus:shadow index bounds ceiling?)
  (let* ((height (ref plus:*vis-height* index))
         (scale (truncate (/ height 8))))
    (when (and (> scale 0) (<= scale maxscale))
      (let* ((rows (* scale 2))
             (center (ref plus:*vis-x* index))
             (padding (if ceiling? 2 1))
             (contact (< rows 64))
             (start (/ (* (- (ref bounds 0) padding) rows) 64))
             (end (/ (* (+ (ref bounds 1) padding) rows) 64))
             (left (+ center (- (if contact (floor start) (truncate start)) scale)))
             (right (+ center (- (if contact (ceiling end) (truncate end)) scale)))
             (bottom (+ (truncate (/ (- viewheight rows) 2)) rows -1))
             (depth (max 1 (truncate (/ rows 64))))
             (limit (+ bottom depth 1))
             (half (arithmetic-shift viewheight -1))
             (distance (plus:distance-falloff-level (- bottom half) half))
             (level (plus:light-level distance (* (+ (ref plus:*vis-tile-x* index) 0.5) TILEGLOBAL)
                                               (* (+ (ref plus:*vis-tile-y* index) 0.5) TILEGLOBAL)))
             (color (if ceiling?
                        (ref plus:*ao-shades* (plus:shade level) (ceiling-color))
                        (plus:color FLOOR (min plus:*level-max* (+ level plus:*shadow-depth*)))))
             (luma (ref plus:*luma* color)))
        (let scan ((row (max half (- bottom depth))))
          (when (and (< row limit) (< row viewheight))
            (let* ((inset (truncate (/ (* (- right left) (abs (- row bottom))) (* depth 4))))
                   (end (min viewwidth (- right inset))))
              (let columns ((column (max 0 (+ left inset))))
                (when (< column end)
                  (when (and (< (ref plus:*wall-height* column) height)
                             (>= row (+ half (ref plus:*boundaries* column))))
                    (let* ((screenrow (if ceiling? (- viewheight 1 row) row))
                           (pixel (+ (* (+ viewtop screenrow) screenwidth) viewleft column)))
                      (when (> (ref plus:*luma* (ref framebuffer pixel)) luma)
                        (setf! framebuffer pixel color))))
                  (columns (+ column 1)))))
            (scan (+ row 1))))))))

(define (plus:draw-shadows)
  (when plus:*active*
    (let sprites ((index 0))
      (when (< index plus:*vis-count*)
        (let ((shape (ref plus:*vis-shape* index)))
          (when (and (>= shape 0) (< shape (vector-length plus:*feet*)))
            (let ((feet (ref plus:*feet* shape))
                  (mount (ref plus:*mounts* shape)))
              (when feet (plus:shadow index feet #f))
              (when mount (plus:shadow index mount #t)))))
        (sprites (+ index 1))))))

(define (plus:pillar-contact index ceiling?)
  (let* ((height (ref plus:*vis-height* index))
         (extent (truncate (/ height 8))))
    (when (and (> extent 0) (<= extent maxscale))
      (let* ((rows (* extent 2))
             (unit (/ rows 64))
             (left (- (ref plus:*vis-x* index) extent))
             (top (truncate (/ (- viewheight rows) 2)))
             (centerx (+ left (* 33 unit)))
             (centery (+ top (* (if ceiling? 4.5 59.5) unit)))
             (radiusx (* 17 unit))
             (radiusy (* 4.5 unit))
             (width (* 1.5 unit))
             (band (+ width 0.5))
             (coverage (min 1 (/ width 0.5)))
             (xweight (/ 1 (* radiusx radiusx)))
             (yweight (/ 1 (* radiusy radiusy)))
             (alpha (ref (ref plus:*sprite-mips* plus:*pillar* 0) 'coverage))
             (start (max 0 (ceiling (- centerx radiusx band 0.5))))
             (end (min viewwidth (ceiling (- (+ centerx radiusx band) 0.5))))
             (limit (min viewheight (ceiling (- (+ centery radiusy band) 0.5)))))

        (let scan ((row (max 0 (ceiling (- centery radiusy band 0.5)))))
          (when (< row limit)
            (let* ((vertical (- (+ row 0.5) centery))
                   (distancey (* vertical vertical yweight))
                   (gradienty (abs (* vertical yweight)))
                   (sourcey (floor (/ (- (+ row 0.5) top) unit)))
                   (boundary (- (if ceiling? (- viewheight 1 row) row) (arithmetic-shift viewheight -1)))
                   (front (if ceiling? (< row centery) (>= row centery)))
                   (base (+ (* (+ viewtop row) screenwidth) viewleft)))
              (let columns ((column start))
                (when (< column end)
                  (when (< (ref plus:*wall-height* column) height)
                    (let* ((horizontal (- (+ column 0.5) centerx))
                           (gradientx (abs (* horizontal xweight)))
                           (gradient (+ (max gradientx gradienty) (* 0.375 (min gradientx gradienty))))
                           (distance (if (zero? gradient) band
                                         (/ (abs (- (+ (* horizontal horizontal xweight) distancey) 1))
                                            (* 2 gradient))))
                           (weight (max 0 (- 1 (/ distance band))))
                           (shade (round (* 8 coverage weight weight (- 3 (* 2 weight))))))
                      (when (> shade 0)
                        (let* ((sourcex (floor (/ (- (+ column 0.5) left) unit)))
                               (solid (and (>= sourcex 0) (< sourcex 64) (>= sourcey 0) (< sourcey 64)
                                           (> (ref alpha (+ (* sourcex 64) sourcey)) 0))))
                          (when (if solid front (>= boundary (ref plus:*boundaries* column)))
                            (let* ((pixel (+ base column))
                                   (color (ref framebuffer pixel))
                                   (dark (ref plus:*pillar-shades* shade color)))
                              (when (< (ref plus:*luma* dark) (ref plus:*luma* color))
                                (setf! framebuffer pixel dark))))))))
                  (columns (+ column 1)))))
            (scan (+ row 1))))))))

(define (plus:maybe-yield)
  (when (and plus:*deadline* (>= (time-monotonic) plus:*deadline*))
    (IN_Yield)
    (set! plus:*deadline* (+ (time-monotonic) plus:*build-slice*))))

(define (plus:prepare surfaces)
  (when plus:*enabled*
    (unless (and plus:*resources* (equal? surfaces (ref plus:*resources* 0)))
      (let ((palette gamepal))
        ; The game coroutine keeps the renderer idle while these tables are rebuilt.
        (set! plus:*resources* #f)
        (set! gamepal (bytevector-copy plus:*base-palette* 0 PALETTEBYTES))
        (set! plus:*deadline* (and in-yield (+ (time-monotonic) plus:*build-slice*)))

        (plus:build-palette surfaces)
        (plus:build-shades)
        (plus:build-dither surfaces)
        (let ((cache (make-vector (* 64 64 64) #f)))
          (plus:build-mips cache)
          (plus:build-sprite-mips cache))
        (plus:build-blends)

        (set! plus:*deadline* #f)
        (set! plus:*resources* (tuple surfaces gamepal))
        (set! gamepal palette)))
    (ref plus:*resources* 1)))

(define (plus:warmup)
  (when plus:*enabled*
    (IN_Yield)
    (plus:prepare (vector FLOOR (ref vgaCeiling 0)))))

(define (plus:palette-loaded)
  (when plus:*enabled*
    (set! plus:*base-palette* gamepal)
    (set! plus:*resources* #f)))

(define (plus:startup)
  (when plus:*enabled*
    (plus:build-sprites)
    (plus:build-contacts)))

(define (plus:level-loaded)
  (when plus:*enabled*
    (set! gamepal (plus:prepare (plus:surface-colors)))
    (InitRedShifts)
    (unless screenfaded (VL_SetPalette gamepal))
    (let reset ((slot 0))
      (when (< slot plus:*flash-count*)
        (plus:clear-map! (ref plus:*flash-maps* slot))
        (setf! plus:*flash-starts* slot -1)
        (reset (+ slot 1))))
    (set! plus:*flash-next* 0)
    (set! plus:*flash-time* #f)
    (plus:build-lights)))

(define (plus:build-planes)
  (let* ((stepx (/ viewsin 2))
         (stepy (/ viewcos 2))
         (forwardx (* scale stepy))
         (forwardy (- (* scale stepx)))
         (center (/ (- viewwidth 1) 2)))
    (let columns ((column 0))
      (when (< column viewwidth)
        (let ((offset (- column center)))
          (setf! plus:*boundaries* column (arithmetic-shift (plus:rows (ref plus:*wall-height* column)) -1))
          (setf! plus:*plane-x* column (+ forwardx (* offset stepx)))
          (setf! plus:*plane-y* column (+ forwardy (* offset stepy))))
        (columns (+ column 1))))))

(define plus:*dither* (make-vector 256 #f))
(define plus:*pattern*
  (let ((pattern
          #(200 94 175 234 98 23 194 115 145 181 19 61 250 89 151 7
            168 37 72 122 52 170 132 77 50 245 106 203 163 21 231 123
            249 137 219 5 207 254 41 224 166 29 131 80 36 183 102 51
            26 83 189 155 108 86 147 1 211 68 191 237 144 218 70 197
            112 226 20 56 180 30 192 119 96 152 12 110 59 3 130 162
            45 146 100 246 126 74 239 58 230 177 46 223 169 255 90 209
            241 64 164 201 9 215 160 16 134 82 202 125 99 34 179 17
            120 185 35 79 141 48 105 188 38 247 24 63 150 199 76 142
            93 4 236 116 173 251 88 220 154 113 167 228 14 244 49 221
            193 156 217 55 205 13 128 28 75 54 190 92 133 109 159 25
            124 71 101 27 149 67 176 233 208 138 6 216 44 187 84 235
            39 178 136 242 95 196 117 47 158 104 252 73 172 11 206 62
            253 8 214 43 165 0 248 85 18 184 32 121 148 232 107 143
            87 195 118 81 227 127 57 204 135 222 97 238 53 78 22 171
            33 153 60 186 31 157 103 174 40 66 161 2 198 182 129 225
            111 243 15 140 210 69 240 10 229 91 212 139 114 42 213 65)))
    (let thresholds ((index 0))
      (when (< index (vector-length pattern))
        (setf! pattern index (/ (+ 0.5 (ref pattern index)) (vector-length pattern)))
        (thresholds (+ index 1))))
    pattern))

(define (plus:dither-pair target)
  (let* ((first (plus:nearest-color target))
         (red (ref gamepal (* first 3)))
         (green (ref gamepal (+ (* first 3) 1)))
         (blue (ref gamepal (+ (* first 3) 2)))
         (error-red (- (ref target 0) red))
         (error-green (- (ref target 1) green))
         (error-blue (- (ref target 2) blue)))
    (let search ((index 0) (second first) (mix 0) (error #f))
      (if (= index 256)
          (let ((first-brightness (+ (* 54 red) (* 183 green) (* 19 blue)))
                (second-brightness (+ (* 54 (ref gamepal (* second 3)))
                                      (* 183 (ref gamepal (+ (* second 3) 1)))
                                      (* 19 (ref gamepal (+ (* second 3) 2))))))
            (if (or (> first-brightness second-brightness)
                    (and (= first-brightness second-brightness) (> first second)))
                (vector second first (- 1 mix))
                (vector first second mix)))
          (let* ((delta-red (- (ref gamepal (* index 3)) red))
                 (delta-green (- (ref gamepal (+ (* index 3) 1)) green))
                 (delta-blue (- (ref gamepal (+ (* index 3) 2)) blue))
                 (distance (+ (* delta-red delta-red) (* delta-green delta-green)
                              (* delta-blue delta-blue)))
                 (weight (if (zero? distance) 0
                             (clamp (/ (+ (* error-red delta-red) (* error-green delta-green)
                                          (* error-blue delta-blue)) distance)
                                    0 1)))
                 (residual-red (- error-red (* weight delta-red)))
                 (residual-green (- error-green (* weight delta-green)))
                 (residual-blue (- error-blue (* weight delta-blue)))
                 (score (+ (* residual-red residual-red) (* residual-green residual-green)
                           (* residual-blue residual-blue) (* plus:*dither-contrast* distance))))
            (if (and (> weight 0) (or (not error) (< score error)))
                (search (+ index 1) index weight score)
                (search (+ index 1) second mix error)))))))

(define (plus:build-dither colors)
  (set! plus:*dither* (make-vector 256 #f))
  (let surfaces ((index 0))
    (when (< index (vector-length colors))
      (let ((color (ref colors index))
            (tables (make-vector (vector-length plus:*ao-depths*) #f)))
        (let layers ((layer 0))
          (when (< layer (vector-length plus:*ao-depths*))
            (let ((table (make-vector plus:*level-count* #f)))
              (let shades ((shade 0))
                (when (< shade plus:*level-count*)
                  (setf! table shade
                         (plus:dither-pair
                           (plus:target color (plus:light-factor (+ shade plus:*level-min*))
                                        (ref plus:*ao-depths* layer) plus:channel-value)))
                  (plus:maybe-yield)
                  (shades (+ shade 1))))
              (setf! tables layer table))
            (layers (+ layer 1))))
        (setf! plus:*dither* color tables))
      (surfaces (+ index 1)))))

(define (plus:plane-color shades layer shade threshold)
  (let ((pair (ref shades layer shade)))
    (ref pair (if (< threshold (ref pair 2)) 1 0))))

(define (plus:draw-planes)
  (when plus:*active*
    (plus:build-planes)
    (let ((halfh (arithmetic-shift viewheight -1))
          (ceiling (ref plus:*dither* (ceiling-color)))
          (floor (ref plus:*dither* FLOOR)))
      (let rows ((height 1) (projection (/ 1 1.5)))
        (when (< height halfh)
          (let* ((edge-projection (/ 1 (+ height 1.5)))
                 (top (- halfh 1 height))
                 (bottom (+ halfh height))
                 (top-offset (+ (* (+ viewtop top) screenwidth) viewleft))
                 (bottom-offset (+ (* (+ viewtop bottom) screenwidth) viewleft))
                 (top-pattern (* (bitwise-and top 15) 16))
                 (bottom-pattern (* (bitwise-and bottom 15) 16)))
            (let columns ((column 0))
              (when (< column viewwidth)
                (let ((boundary (ref plus:*boundaries* column)))
                  (when (>= height boundary)
                    (let* ((edge (= height boundary))
                           (sample-projection (if edge edge-projection projection))
                           (worldx (+ viewx (* (ref plus:*plane-x* column) sample-projection)))
                           (worldy (+ viewy (* (ref plus:*plane-y* column) sample-projection)))
                           (level (plus:light-level 0 worldx worldy))
                           (shade (clamp (round (- level plus:*level-min*))
                                         0 (- plus:*level-count* 1)))
                           (layer (plus:ao-layer worldx worldy edge))
                           (phase (bitwise-and column 15)))
                      (setf! framebuffer (+ top-offset column)
                             (plus:plane-color ceiling layer shade
                                               (ref plus:*pattern* (+ top-pattern phase))))
                      (setf! framebuffer (+ bottom-offset column)
                             (plus:plane-color floor layer shade
                                               (ref plus:*pattern* (+ bottom-pattern phase)))))))
                (columns (+ column 1))))
            (rows (+ height 1) edge-projection)))))))

(define (plus:door-edge column height)
  (when plus:*active*
    (let* ((rows (plus:rows height))
           (top (truncate (/ (- viewheight rows) 2)))
           (start (max top 0))
           (end (min viewheight (+ top (quotient (+ rows 63) 64)))))
      (when (and (>= rows 4) (< start end))
        (let* ((pixel (+ (* (+ viewtop start) screenwidth) viewleft column))
               (color (ref framebuffer pixel))
               (shade (plus:color color 48)))
          (when (< (ref plus:*luma* shade) (ref plus:*luma* color))
            (let pixels ((row start) (pixel pixel))
              (when (< row end)
                (setf! framebuffer pixel shade)
                (pixels (+ row 1) (+ pixel screenwidth))))))))))

(define (plus:calc-height column xintercept yintercept)
  (setf! plus:*wall-x* column xintercept)
  (setf! plus:*wall-y* column yintercept)
  (let* ((gx (- xintercept viewx))
         (gy (- yintercept viewy))
         (nx (- (FixedByFrac gx viewcos) (FixedByFrac gy viewsin)))
         (dist (max nx MINDIST)))
    (truncate (/ heightnumerator (truncate (/ dist 256))))))

(define (plus:rows height)
  (let* ((raw (truncate (/ height 8)))
         (scale (cond ((< raw 1) 1)
                      ((> raw maxscale) maxscale)
                      (else raw)))
         (scaled (if (< scale stepbytwo)
                     scale
                     (+ stepbytwo (* 3 (truncate (/ (- scale stepbytwo) 3)))))))
    (* 2 scaled)))

(define (plus:scale-post pixx scaleheight page column tilex tiley vertical)
  (let* ((rows (plus:rows scaleheight))
         (tile-left (* tilex TILEGLOBAL))
         (tile-top (* tiley TILEGLOBAL))
         (lightx (clamp (ref plus:*wall-x* pixx)
                        (+ tile-left 1) (+ tile-left TILEGLOBAL -1)))
         (lighty (clamp (ref plus:*wall-y* pixx)
                        (+ tile-top 1) (+ tile-top TILEGLOBAL -1)))
         (level (plus:light-level (plus:distance-falloff-level rows viewheight) lightx lighty))
         (shade (ref plus:*shades* (plus:shade level)))
         (top (truncate (/ (- viewheight rows) 2)))
         (mip (plus:wall-mip page pixx vertical))
         (width (if mip (ref mip 'width) 64))
         (height (if mip (ref mip 'height) 64))
         (texels (if mip (ref mip 'texels) (PM_GetPage page)))
         (offset (* (quotient (* column width) 64) height))
         (limit (min (+ top rows) viewheight)))
    (let loop ((row (max top 0)))
      (when (< row limit)
        (let ((texel (truncate (/ (* (- row top) height) rows))))
          (setf! framebuffer (+ (* (+ row viewtop) screenwidth) viewleft pixx)
                 (ref shade (ref texels (+ offset texel)))))
        (loop (+ row 1))))))

(define (plus:cache-wall-height! pixx same-hit height)
  (let ((height (if same-hit (ref plus:*wall-height* (- pixx 1)) height)))
    (setf! plus:*wall-height* pixx height)
    height))

(define (plus:hit-vertical-wall pixx tile xtile yinttile xtilestep yintercept)
  (let* ((hitx (+ (* xtile TILEGLOBAL) (if (= xtilestep -1) TILEGLOBAL 0)))
         (texture (bitwise-and (arithmetic-shift yintercept -4) 4032))
         (column (quotient (if (= xtilestep -1) (- 4032 texture) texture) 64))
         (raw-height (plus:calc-height pixx hitx yintercept))
         (page (vertpage tile xtile yinttile xtilestep))
         (same-wall (and (eq? plus:*last-hit* 'vertical-wall)
                         (= plus:*last-vertical-x-tile* xtile)
                         (= plus:*last-vertical-tile* tile)
                         (= plus:*last-vertical-texture* texture)))
         (height (plus:cache-wall-height! pixx same-wall raw-height)))
    (set! plus:*last-hit* 'vertical-wall)
    (set! plus:*last-vertical-x-tile* xtile)
    (set! plus:*last-vertical-tile* tile)
    (set! plus:*last-vertical-texture* texture)
    (plus:scale-post pixx height page column (- xtile xtilestep) yinttile #t)
    (when (= page (+ (doorwall) 3))
      (plus:door-edge pixx height))))

(define (plus:hit-horizontal-wall pixx tile xinttile ytile ytilestep xintercept)
  (let* ((hity (+ (* ytile TILEGLOBAL) (if (= ytilestep -1) TILEGLOBAL 0)))
         (texture (bitwise-and (arithmetic-shift xintercept -4) 4032))
         (column (quotient (if (= ytilestep -1) (- 4032 texture) texture) 64))
         (raw-height (plus:calc-height pixx xintercept hity))
         (page (horizpage tile xinttile ytile ytilestep))
         (same-wall (and (eq? plus:*last-hit* 'horizontal-wall)
                         (= plus:*last-horizontal-y-tile* ytile)
                         (= plus:*last-horizontal-tile* tile)
                         (= plus:*last-horizontal-texture* texture)))
         (height (plus:cache-wall-height! pixx same-wall raw-height)))
    (set! plus:*last-hit* 'horizontal-wall)
    (set! plus:*last-horizontal-y-tile* ytile)
    (set! plus:*last-horizontal-tile* tile)
    (set! plus:*last-horizontal-texture* texture)
    (plus:scale-post pixx height page column xinttile (- ytile ytilestep) #f)
    (when (= page (+ (doorwall) 2))
      (plus:door-edge pixx height))))

(define (plus:set-door-hit! door texture)
  (set! plus:*last-hit* 'door)
  (set! plus:*last-door-number* door)
  (set! plus:*last-door-texture* texture))

(define (plus:hit-horizontal-door pixx door xmid ytile)
  (let* ((hity (+ (* ytile TILEGLOBAL) 32768))
         (texture (bitwise-and (arithmetic-shift (- xmid (ref doorposition door)) -4) 4032))
         (column (quotient texture 64))
         (raw-height (plus:calc-height pixx xmid hity))
         (same-door (and (eq? plus:*last-hit* 'door)
                         (= plus:*last-door-number* door) (= plus:*last-door-texture* texture)))
         (height (plus:cache-wall-height! pixx same-door raw-height)))
    (plus:set-door-hit! door texture)
    (plus:scale-post pixx height (doorpage (ref doorlock door) #f) column
                     (ref doortilex door) (if (< viewy hity) (- ytile 1) (+ ytile 1)) #f)
    (plus:door-edge pixx height)))

(define (plus:hit-vertical-door pixx door ymid xtile)
  (let* ((hitx (+ (* xtile TILEGLOBAL) 32768))
         (texture (bitwise-and (arithmetic-shift (- ymid (ref doorposition door)) -4) 4032))
         (column (quotient texture 64))
         (raw-height (plus:calc-height pixx hitx ymid))
         (same-door (and (eq? plus:*last-hit* 'door)
                         (= plus:*last-door-number* door) (= plus:*last-door-texture* texture)))
         (height (plus:cache-wall-height! pixx same-door raw-height)))
    (plus:set-door-hit! door texture)
    (plus:scale-post pixx height (doorpage (ref doorlock door) #t) column
                     (if (< viewx hitx) (- xtile 1) (+ xtile 1)) (ref doortiley door) #t)
    (plus:door-edge pixx height)))

(define (plus:set-pushwall-hit! tile texture)
  (set! plus:*last-hit* 'pushwall)
  (set! plus:*last-pwall-tile* tile)
  (set! plus:*last-pwall-texture* texture))

(define (plus:hit-horizontal-pushwall pixx tile xmid ytile ytilestep)
  (let* ((offset (* pwallpos 1024))
         (hity (+ (* ytile TILEGLOBAL) (if (= ytilestep -1) (- TILEGLOBAL offset) offset)))
         (texture (bitwise-and (arithmetic-shift xmid -4) 4032))
         (column (quotient (if (= ytilestep -1) texture (- 4032 texture)) 64))
         (raw-height (plus:calc-height pixx xmid hity))
         (same-pwall (and (eq? plus:*last-hit* 'pushwall)
                          (= plus:*last-pwall-tile* tile) (= plus:*last-pwall-texture* texture)))
         (height (plus:cache-wall-height! pixx same-pwall raw-height)))
    (plus:set-pushwall-hit! tile texture)
    (plus:scale-post pixx height (horizpwall tile) column
                     (bitwise-and (arithmetic-shift xmid -16) 63) (- ytile ytilestep) #f)))

(define (plus:hit-vertical-pushwall pixx tile ymid xtile xtilestep)
  (let* ((offset (* pwallpos 1024))
         (hitx (+ (* xtile TILEGLOBAL) (if (= xtilestep -1) (- TILEGLOBAL offset) offset)))
         (texture (bitwise-and (arithmetic-shift ymid -4) 4032))
         (column (quotient (if (= xtilestep -1) (- 4032 texture) texture) 64))
         (raw-height (plus:calc-height pixx hitx ymid))
         (same-pwall (and (eq? plus:*last-hit* 'pushwall)
                          (= plus:*last-pwall-tile* tile) (= plus:*last-pwall-texture* texture)))
         (height (plus:cache-wall-height! pixx same-pwall raw-height)))
    (plus:set-pushwall-hit! tile texture)
    (plus:scale-post pixx height (vertpwall tile) column
                     (- xtile xtilestep) (bitwise-and (arithmetic-shift ymid -16) 63) #t)))

(define (plus:intercept-in-tile? intercept tile)
  (= (tileof intercept) tile))

(define (plus:door-intercept? intercept tile door)
  (and (plus:intercept-in-tile? intercept tile)
       (>= (- intercept (* tile TILEGLOBAL)) (ref doorposition door))))

(define (plus:cast-column pixx)
  (let* ((raw-angle (+ (* player-angle 10) (ref pixelangle pixx)))
         (angle (cond ((< raw-angle 0) (+ raw-angle FINEANGLES))
                      ((>= raw-angle ANG360) (- raw-angle FINEANGLES))
                      (else raw-angle)))
         (xtilestep (if (or (< angle ANG90) (>= angle ANG270)) 1 -1))
         (ytilestep (if (< angle ANG180) -1 1))
         (xstep (cond ((< angle ANG90) (ref finetangent (- ANG90 1 angle)))
                      ((< angle ANG180) (- (ref finetangent (- angle ANG90))))
                      ((< angle ANG270) (- (ref finetangent (- ANG270 1 angle))))
                      (else (ref finetangent (- angle ANG270)))))
         (ystep (cond ((< angle ANG90) (- (ref finetangent angle)))
                      ((< angle ANG180) (- (ref finetangent (- ANG180 1 angle))))
                      ((< angle ANG270) (ref finetangent (- angle ANG180)))
                      (else (ref finetangent (- ANG360 1 angle)))))
         (xpartial (if (= xtilestep 1) xpartialup xpartialdown))
         (ypartial (if (= ytilestep 1) ypartialup ypartialdown)))
    (let loop ((xtile (+ focaltx xtilestep))
               (ytile (+ focalty ytilestep))
               (xintercept (+ (FixedByFrac xstep ypartial) viewx))
               (yintercept (+ (FixedByFrac ystep xpartial) viewy))
               (steps 0))
      (and (<= steps 256)
           (let ((yinttile (tileof yintercept))
                (xinttile (tileof xintercept)))
            (if (if (= ytilestep -1) (<= yinttile ytile) (>= yinttile ytile))
                (let* ((inside (plus:in-map? xinttile ytile))
                       (tile (if inside (tileat xinttile ytile) 1)))
                  (define (advance-horizontal)
                    (when inside (spotvis-mark xinttile ytile))
                    (loop xtile (+ ytile ytilestep) (+ xintercept xstep) yintercept (+ steps 1)))

                  (cond
                    ((<= tile 0) (advance-horizontal))
                    ((plus:pushwall-tile? tile)
                     (let ((xmid (+ xintercept (truncate (/ (* xstep pwallpos) 64)))))
                       (if (plus:intercept-in-tile? xmid xinttile)
                           (plus:hit-horizontal-pushwall pixx tile xmid ytile ytilestep)
                           (advance-horizontal))))
                    ((>= tile 128)
                     (let ((door (bitwise-and tile 127))
                           (xmid (+ xintercept (halfstep xstep))))
                       (if (plus:door-intercept? xmid xinttile door)
                           (plus:hit-horizontal-door pixx door xmid ytile)
                           (advance-horizontal))))
                    (else (plus:hit-horizontal-wall pixx tile xinttile ytile ytilestep xintercept))))
                (let* ((inside (plus:in-map? xtile yinttile))
                       (tile (if inside (tileat xtile yinttile) 1)))
                  (define (advance-vertical)
                    (when inside (spotvis-mark xtile yinttile))
                    (loop (+ xtile xtilestep) ytile xintercept (+ yintercept ystep) (+ steps 1)))

                  (cond
                    ((<= tile 0) (advance-vertical))
                    ((plus:pushwall-tile? tile)
                     (let ((ymid (+ yintercept (truncate (/ (* ystep pwallpos) 64)))))
                       (if (plus:intercept-in-tile? ymid yinttile)
                           (plus:hit-vertical-pushwall pixx tile ymid xtile xtilestep)
                           (advance-vertical))))
                    ((>= tile 128)
                     (let ((door (bitwise-and tile 127))
                           (ymid (+ yintercept (halfstep ystep))))
                       (if (plus:door-intercept? ymid yinttile door)
                           (plus:hit-vertical-door pixx door ymid xtile)
                           (advance-vertical))))
                    (else (plus:hit-vertical-wall pixx tile xtile yinttile xtilestep yintercept))))))))))

(define (plus:draw-walls)
  (set! plus:*last-hit* #f)
  (set! viewsin (ref sintable player-angle))
  (set! viewcos (ref costable player-angle))
  (set! viewx (- player-x (FixedByFrac focallength viewcos)))
  (set! viewy (+ player-y (FixedByFrac focallength viewsin)))
  (set! focaltx (tileof viewx))
  (set! focalty (tileof viewy))
  (set! xpartialdown (- viewx (* focaltx TILEGLOBAL)))
  (set! xpartialup (- TILEGLOBAL xpartialdown))
  (set! ypartialdown (- viewy (* focalty TILEGLOBAL)))
  (set! ypartialup (- TILEGLOBAL ypartialdown))
  (let loop ((column 0))
    (when (< column viewwidth)
      (plus:cast-column column)
      (loop (+ column 1)))))

(define (plus:column-width rows sourcex)
  (- (truncate (/ (* (+ sourcex 1) rows) 64))
     (truncate (/ (* sourcex rows) 64))))

(define (plus:shape-column page leftpix sourcex screenx rows top shade emissive)
  (let posts ((offset (readu16 page (+ 4 (* (- sourcex leftpix) 2)))))
    (let ((endpixel (readu16 page offset)))
      (when (> endpixel 0)
        (let ((topofs (readi16 page (+ offset 2)))
              (startpixel (readu16 page (+ offset 4))))
          (let texels ((texel (truncate (/ startpixel 2))))
            (when (< texel (truncate (/ endpixel 2)))
              (let ((start (max 0 (+ top (truncate (/ (* texel rows) 64)))))
                    (limit (min viewheight (+ top (truncate (/ (* (+ texel 1) rows) 64))))))
                (when (< start limit)
                  (let ((color (plus:shaded-sprite-color (ref page (+ topofs texel)) shade emissive)))
                    (let fill ((row start))
                      (when (< row limit)
                        (setf! framebuffer (+ (* (+ row viewtop) screenwidth) viewleft screenx) color)
                        (set! sprite-pixels (+ sprite-pixels 1))
                        (fill (+ row 1)))))))
              (texels (+ texel 1)))))
        (posts (+ offset 6))))))

(define (plus:draw-run page leftpix sourcex start width rows top shade emissive)
  (let loop ((column 0))
    (when (< column width)
      (plus:shape-column page leftpix sourcex (+ start column) rows top shade emissive)
      (loop (+ column 1)))))

(define (plus:place-run page leftpix sourcex start width rows top height clip outward-left shade emissive)
  (define (draw start width stop?)
    (when (> width 0)
      (plus:draw-run page leftpix sourcex start width rows top shade emissive))
    stop?)

  (if clip
      (let ((leftvis (< (ref plus:*wall-height* start) height))
            (rightvis (< (ref plus:*wall-height* (+ start width -1)) height)))
        (cond ((and leftvis rightvis) (draw start width #f))
              (leftvis (let shrink ((count width))
                         (if (>= (ref plus:*wall-height* (+ start count -1)) height)
                             (shrink (- count 1))
                             (draw start count (not outward-left)))))
              (rightvis (let advance ((column start) (count width))
                          (if (>= (ref plus:*wall-height* column) height)
                              (advance (+ column 1) (- count 1))
                              (draw column count outward-left))))
              (else #f)))
      (draw start width #f)))

(define (plus:draw-shape screenx page height rows top clip shade emissive)
  (let ((leftpix (readu16 page 0))
        (rightpix (readu16 page 2)))
    (let left ((sourcex 31) (slinex screenx))
      (when (and (>= sourcex leftpix) (> slinex 0))
        (let ((width (plus:column-width rows sourcex)))
          (if (zero? width)
              (left (- sourcex 1) slinex)
              (let* ((clamped (if (> slinex viewwidth) width (if (> width slinex) slinex width)))
                     (start (- slinex clamped))
                     (visible (if (> slinex viewwidth) (- viewwidth start) clamped)))
                (if (< visible 1)
                    (left (- sourcex 1) start)
                    (unless (plus:place-run page leftpix sourcex start visible rows top height clip
                                            #t shade emissive)
                      (left (- sourcex 1) start))))))))
    (let right ((sourcex (if (< leftpix 31) 31 (- leftpix 1)))
                (slinex screenx)
                (slinewidth 0))
      (let ((next (+ sourcex 1))
            (column (+ slinex slinewidth)))
        (when (and (<= next rightpix) (< column viewwidth))
          (let ((width (plus:column-width rows next)))
            (cond
              ((zero? width) (right next column 0))
              ((and (< column 0) (<= width (- column))) (right next column width))
              (else
               (let* ((start (if (< column 0) 0 column))
                      (visible (cond ((< column 0) (+ width column))
                                     ((> (+ column width) viewwidth) (- viewwidth column))
                                     (else width))))
                 (unless (plus:place-run page leftpix next start visible rows top height clip
                                         #f shade emissive)
                   (right next start visible)))))))))))

(define (plus:world-shape screenx shapenum height tilex tiley)
  (let ((page (or (ref plus:*sprites* shapenum) (PM_GetPage (+ PMSpriteStart shapenum))))
        (scale (truncate (/ height 8))))
    (when (and (> scale 0) (<= scale maxscale))
      (let* ((rows (* scale 2))
             (level (plus:light-level (plus:distance-falloff-level rows viewheight)
                                     (* (+ tilex 0.5) TILEGLOBAL) (* (+ tiley 0.5) TILEGLOBAL)))
             (emission (plus:light-emission shapenum))
             (shade (ref plus:*shades* (plus:shade level)))
             (emissive (cond ((= emission 1) (ref plus:*shades* (plus:shade (truncate (/ level 2)))))
                             ((= emission 2) (ref plus:*shades* (plus:shade 0)))
                             (else #f)))
             (top (truncate (/ (- viewheight rows) 2))))
        (if (< rows 64)
            (plus:scale-sprite screenx shapenum height rows top shade emissive)
            (plus:draw-shape screenx page height rows top #t shade emissive))))))

(define (plus:overlay-shape screenx shapenum height)
  (let ((page (PM_GetPage (+ PMSpriteStart shapenum)))
        (scale (truncate (/ height 2))))
    (when (and (> scale 0) (<= scale maxscale))
      (let* ((rows (* scale 2))
             (top (truncate (/ (- viewheight rows) 2)))
             (shade (ref plus:*shades* (plus:shade 0))))
        (plus:draw-shape screenx page height rows top #f shade #f)))))

(define (plus:vis-add screenx height shapenum tilex tiley)
  (setf! plus:*vis-x* plus:*vis-count* screenx)
  (setf! plus:*vis-height* plus:*vis-count* height)
  (setf! plus:*vis-shape* plus:*vis-count* shapenum)
  (setf! plus:*vis-tile-x* plus:*vis-count* tilex)
  (setf! plus:*vis-tile-y* plus:*vis-count* tiley)
  (when (< plus:*vis-count* (- MAXVISABLE 1))
    (set! plus:*vis-count* (+ plus:*vis-count* 1))))

(define (plus:place-statics)
  (let loop ((index 0))
    (when (< index statcount)
      (let ((tilex (ref stat-tilex index))
            (tiley (ref stat-tiley index)))
        (unless (or (= (ref stat-shape index) -1) (zero? (spotvis-at tilex tiley)))
          (let* ((transformed (TransformTile tilex tiley))
                 (screenx (car transformed))
                 (height (cadr transformed))
                 (grab (caddr transformed)))
            (if (and grab (plus:bit-set? (ref stat-flags index) FL_BONUS))
                (GetBonus index)
                (unless (zero? height)
                  (plus:vis-add screenx height (ref stat-shape index) tilex tiley))))))
      (loop (+ index 1)))))

(define (plus:place-actors)
  (let loop ((index 0))
    (when (< index actorcount)
      (let ((shapenum (if (ref actor-state index)
                          (ref actor-state index 'shapenum)
                          0)))
        (if (or (zero? shapenum) (not (actor-visible index)))
            (setf! actor-flags index (bitwise-and (ref actor-flags index) (- 255 FL_VISABLE)))
            (begin
              (setf! actor-active index #t)
              (let* ((transformed (TransformActor index))
                     (screenx (car transformed))
                     (height (cadr transformed)))
                (unless (zero? height)
                  (plus:vis-add screenx height
                                (+ (if (= shapenum -1) (ref actor-temp1 index) shapenum)
                                   (if (actor-rotates index) (CalcRotate index screenx) 0))
                                (ref actor-tilex index) (ref actor-tiley index))
                  (setf! actor-flags index
                         (bitwise-ior (ref actor-flags index) FL_VISABLE)))))))
      (loop (+ index 1)))))

(define (plus:sort-vis)
  (let sprites ((index 0))
    (when (< index plus:*vis-count*)
      (let ((height (ref plus:*vis-height* index)))
        (let insert ((slot index))
          (if (zero? slot)
              (setf! plus:*vis-order* slot index)
              (let ((previous (ref plus:*vis-order* (- slot 1))))
                (if (> (ref plus:*vis-height* previous) height)
                    (begin
                      (setf! plus:*vis-order* slot previous)
                      (insert (- slot 1)))
                    (setf! plus:*vis-order* slot index))))))
      (sprites (+ index 1)))))

(define (plus:draw-scaleds)
  (set! plus:*vis-count* 0)
  (plus:place-statics)
  (plus:place-actors)
  (plus:draw-shadows)
  (plus:sort-vis)
  (let draw ((drawn 0))
    (when (< drawn plus:*vis-count*)
      (let ((index (ref plus:*vis-order* drawn)))
        (plus:world-shape (ref plus:*vis-x* index) (ref plus:*vis-shape* index)
                          (ref plus:*vis-height* index)
                          (ref plus:*vis-tile-x* index) (ref plus:*vis-tile-y* index))
        (when (= (ref plus:*vis-shape* index) plus:*pillar*)
          (plus:pillar-contact index #f)
          (plus:pillar-contact index #t)))
      (draw (+ drawn 1))))
  plus:*vis-count*)

(define (plus:draw-weapon)
  (if (and (not spear-mode) victoryflag)
      (when (and deathcam-active (plus:bit-set? TimeCount 32))
        (plus:overlay-shape (quotient viewwidth 2) SPR_DEATHCAM (+ viewheight 1)))
      (begin
        (unless (= weapon -1)
          (plus:overlay-shape (quotient viewwidth 2) (+ (ref weaponscale weapon) weaponframe)
                              (+ viewheight 1)))
        (when (or demorecord demoplayback)
          (plus:overlay-shape (quotient viewwidth 2) SPR_DEMO (+ viewheight 1))))))

(define (plus:render)
  (plus:update-lights)
  (plus:update-flashes)
  (spotvis-clear)
  (let ((top (ceiling-color))
        (half (truncate (/ viewheight 2))))
    (let rows ((row 0))
      (when (< row (* half 2))
        (bytevector-fill! framebuffer (+ (* (+ row viewtop) screenwidth) viewleft)
                          viewwidth (if (< row half) top FLOOR))
        (rows (+ row 1)))))
  (plus:draw-walls)
  (plus:draw-planes)
  (plus:draw-scaleds)
  (plus:draw-weapon))

(define (plus:refresh)
  (when (plus:resize) (DrawPlayBorder))
  (if plus:*active*
      (let ((display (and fizzlein (bytevector-copy framebuffer 0 (bytevector-length framebuffer)))))
        (plus:render)
        (when fizzlein
          (let ((rendered (bytevector-copy framebuffer 0 (bytevector-length framebuffer))))
            (bytevector-copy! framebuffer 0 display 0 (bytevector-length display))
            (FizzleFade rendered viewleft viewtop viewwidth viewheight 20 #f))
          (set! fizzlein #f)
          (set! lasttimecount 0)
          (set! TimeCount 0))
        (bytevector-copy! displayframebuffer 0 framebuffer 0 (bytevector-length framebuffer))
        (set! frameon (+ frameon 1))
        (PM_NextFrame))
      (plus:*base-refresh*)))

(define (plus:sb-segment data length)
  (dos:play-sound 'digi (plus:samples data length) DIGIHERTZ)
  length)

(define (plus:ss-sample data length)
  (set! ssSample data)
  (dos:play-sound 'digi (plus:samples data length) DIGIHERTZ))

(define (plus:load-palette)
  (let* ((path (string-append datadir GAMEPALOBJ))
         (object (CA_LoadFile path)))
    (unless object
      (Quit (string-append "Can't open " path ". Copy WOLFSRC/OBJ/GAMEPAL.OBJ from the Wolf3D source release here.")))
    (let ((palette (gamepal-from-object object)))
      (unless palette
        (Quit (string-append path " is not a supported GAMEPAL.OBJ")))
      (set! gamepal palette)
      (plus:palette-loaded)
      (VL_SetPalette palette))))

(define (plus:setup-level)
  (unless loadedgame
    (set! TimeCount 0)
    (set! secretcount 0)
    (set! secrettotal 0)
    (set! killcount 0)
    (set! killtotal 0)
    (set! treasurecount 0)
    (set! treasuretotal 0))
  (set! pwallstate 0)
  (set! playstate ex_stillplaying)
  (US_InitRndT (if (or demoplayback demorecord) 0
                   (bitwise-and (truncate (* (time-monotonic) 70)) 255)))
  (CA_CacheMap (+ mapon (* episode 10)))
  (set! mapon (- mapon (* episode 10)))
  (SetupTileMap)
  (InitActorList)
  (InitDoorList)
  (InitStaticList)
  (SpawnDoors)
  (ScanInfoPlane)
  (plus:level-loaded)
  (ClearAmbushMarkers)
  (CA_LoadAllSounds))

(define (plus:pg13)
  (VWB_Bar 0 0 320 200 130)
  (CA_CacheGrChunk PG13PIC)
  (VWB_DrawPic 216 110 PG13PIC)
  (VW_UpdateScreen)
  (VL_FadeIn 0 255 gamepal 30)
  (let ((started TimeCount))
    (IN_StartAck)
    (plus:warmup)
    (unless (IN_CheckAck)
      (IN_UserInput (max 0 (- (* TickBase 7) (- TimeCount started))))))
  (VL_FadeOut 0 255 0 0 0 30))

(define (plus:gun-attack)
  (cond ((= weapon wp_pistol) (SD_PlaySound ATKPISTOLSND))
        ((= weapon wp_machinegun) (SD_PlaySound ATKMACHINEGUNSND))
        ((= weapon wp_chaingun) (SD_PlaySound ATKGATLINGSND)))
  (set! madenoise #t)
  (plus:flash-at player-tilex player-tiley)
  (let ((closest (car (closest-target))))
    (when (and (>= closest 0) (CheckLine closest))
      (let* ((dx (abs (- (ref actor-tilex closest) player-tilex)))
             (dy (abs (- (ref actor-tiley closest) player-tiley)))
             (dist (max dx dy)))
        (cond ((< dist 2) (DamageActor closest (truncate (/ (US_RndT) 4))))
              ((< dist 4) (DamageActor closest (truncate (/ (US_RndT) 6))))
              ((>= (truncate (/ (US_RndT) 12)) dist)
               (DamageActor closest (truncate (/ (US_RndT) 6)))))))))

(define (plus:shoot index tics)
  (when (and (areabyplayer-at (ref actor-areanumber index)) (CheckLine index))
    (plus:flash-at (ref actor-tilex index) (ref actor-tiley index))
    (let* ((dx (abs (- (ref actor-tilex index) player-tilex)))
           (dy (abs (- (ref actor-tiley index) player-tiley)))
           (spread (max dx dy))
           (dist (if (or (= (ref actor-class index) (class-of en_ss))
                         (= (ref actor-class index) bossobj))
                     (truncate (/ (* spread 2) 3))
                     spread))
           (visible (plus:bit-set? (ref actor-flags index) FL_VISABLE))
           (hitchance (- (if (>= thrustspeed RUNSPEED) 160 256)
                         (* dist (if visible 16 8)))))
      (when (< (US_RndT) hitchance)
        (TakeDamage (cond ((< dist 2) (arithmetic-shift (US_RndT) -2))
                          ((< dist 4) (arithmetic-shift (US_RndT) -3))
                          (else (arithmetic-shift (US_RndT) -4)))
                    index))
      (let ((class (ref actor-class index)))
        (PlaySoundLocActor
         (cond ((= class (class-of en_ss)) SSFIRESND)
               ((or (= class giftobj) (= class fatobj)) MISSILEFIRESND)
               ((or (= class mechahitlerobj) (= class realhitlerobj) (= class bossobj)) BOSSFIRESND)
               ((= class schabbobj) SCHABBSTHROWSND)
               ((= class fakeobj) FLAMETHROWERSND)
               (else NAZIFIRESND))
         index)))))

(define (plus:plot column row color)
  (setf! framebuffer (+ (* row screenwidth) plus:*screen-offset* column) color))

(define (plus:hline column row width color)
  (when (> width 0)
    (bytevector-fill! framebuffer (+ (* row screenwidth) plus:*screen-offset* column) (ceiling width) color)))

(define (plus:clip-plot column row color)
  (let ((offset (+ column plus:*screen-offset*)))
    (when (and (>= offset 0) (< offset screenwidth) (>= row 0) (< row screenheight))
      (setf! framebuffer (+ (* row screenwidth) offset) color))))

(define (plus:clip-hline start end row color)
  (let ((left (max 0 (+ start plus:*screen-offset*)))
        (right (min (- screenwidth 1) (+ end plus:*screen-offset*))))
    (when (and (<= left right) (>= row 0) (< row screenheight))
      (bytevector-fill! framebuffer (+ (* row screenwidth) left) (+ (floor (- right left)) 1) color))))

(define (plus:mark-update left top right bottom)
  (let ((xt1 (max 0 (arithmetic-shift (+ left plus:*screen-offset*) -4)))
        (yt1 (max 0 (arithmetic-shift top -4)))
        (xt2 (min (- UPDATEWIDE 1) (arithmetic-shift (+ right plus:*screen-offset*) -4)))
        (yt2 (min (- UPDATEHIGH 1) (arithmetic-shift bottom -4))))
    (and (< xt1 UPDATEWIDE) (< yt1 UPDATEHIGH) (>= xt2 0) (>= yt2 0)
         (begin
           (let rows ((row yt1))
             (when (<= row yt2)
               (when (<= xt1 xt2)
                 (bytevector-fill! update (+ (* row UPDATEWIDE) xt1) (+ (- xt2 xt1) 1) 1))
               (rows (+ row 1))))
           #t))))

(define (plus:latch-to-screen source width height left top)
  (let rows ((row 0))
    (when (< row height)
      (let bytes ((byte 0))
        (when (< byte width)
          (let planes ((plane 0))
            (when (< plane 4)
              (let ((column (+ plus:*screen-offset* left (* byte 4) plane))
                    (screenrow (+ top row)))
                (when (and (>= column 0) (< column screenwidth) (>= screenrow 0) (< screenrow screenheight))
                  (setf! framebuffer (+ (* screenrow screenwidth) column)
                         (ref latch-planes plane (+ source (* row width) byte)))))
              (planes (+ plane 1))))
          (bytes (+ byte 1))))
      (rows (+ row 1)))))

(define (plus:screen-to-screen source dest width height)
  (let ((copy (bytevector-copy framebuffer 0 (bytevector-length framebuffer)))
        (source-y (quotient source linewidth))
        (source-x (+ plus:*screen-offset* (* (remainder source linewidth) 4)))
        (dest-y (quotient dest linewidth))
        (dest-x (+ plus:*screen-offset* (* (remainder dest linewidth) 4))))
    (let rows ((row 0))
      (when (< row height)
        (let ((start (+ (* (+ source-y row) screenwidth) source-x)))
          (bytevector-copy! framebuffer (+ (* (+ dest-y row) screenwidth) dest-x)
                            copy start (+ start (* width 4))))
        (rows (+ row 1))))))

(define (plus:fade source left top width height frames abortable)
  (let ((pixperframe (truncate (/ 64000 frames))))
    (IN_StartAck)
    (let per-frame ((rndval 1))
      (if (and abortable (IN_CheckAck))
          #t
          (let pixels ((count 0) (rndval rndval))
            (if (>= count pixperframe)
                (begin (VL_WaitVBL 1) (per-frame rndval))
                (let ((row (bitwise-and (- (bitwise-and rndval 255) 1) 255))
                      (start (bitwise-and (arithmetic-shift rndval -8) 65535))
                      (next (let ((shifted (arithmetic-shift rndval -1)))
                              (if (plus:bit-set? rndval 1)
                                  (bitwise-xor shifted 73728)
                                  shifted))))
                  (when (<= row height)
                    (let columns ((column start))
                      (when (<= column width)
                        (let ((offset (+ (* (+ top row) screenwidth) left column)))
                          (when (< offset (bytevector-length framebuffer))
                            (setf! framebuffer offset (ref source offset))))
                        (columns (+ column 512)))))
                  (if (= next 1)
                      #f
                      (pixels (+ count 1) next)))))))))

(define (plus:border-sides)
  (let ((left (- viewleft plus:*screen-offset*))
        (bottom (+ viewtop viewheight)))
    (VWB_Bar (- plus:*screen-offset*) 0 (- viewleft 1) (- screenheight STATUSLINES) 127)
    (VWB_Bar (+ left viewwidth 1) 0 (- viewleft 2) (- screenheight STATUSLINES) 127)
    (VWB_Vlin (- viewtop 1) bottom (- left 1) 0)
    (VWB_Vlin (- viewtop 1) bottom (+ left viewwidth) 125)))

(define (plus:border)
  (VWB_Bar (- plus:*screen-offset*) 0 screenwidth (- screenheight STATUSLINES) 127)
  (let* ((left (- viewleft plus:*screen-offset*))
         (right (+ left viewwidth))
         (bottom (+ viewtop viewheight)))
    (VWB_Bar left viewtop viewwidth viewheight 0)
    (VWB_Hlin (- left 1) right (- viewtop 1) 0)
    (VWB_Hlin (- left 1) right bottom 125)
    (VWB_Vlin (- viewtop 1) bottom (- left 1) 0)
    (VWB_Vlin (- viewtop 1) bottom right 125)
    (VWB_Plot (- left 1) bottom 124)))

(define (plus:play-screen)
  (VL_FadeOut 0 255 0 0 0 30)
  (CA_CacheGrChunk STATUSBARPIC)
  (DrawPlayBorder)
  (when (> plus:*screen-offset* 0)
    (VWB_Bar (- plus:*screen-offset*) (- screenheight STATUSLINES) screenwidth STATUSLINES 127))
  (VWB_DrawPic 0 (- screenheight STATUSLINES) STATUSBARPIC)
  (DrawFace)
  (DrawHealth)
  (DrawLives)
  (DrawLevel)
  (DrawAmmo)
  (DrawKeys)
  (DrawWeapon)
  (DrawScore))

(define (plus:clear-split)
  (plus:*base-clear-split*)
  (when (> plus:*screen-offset* 0)
    (VWB_Bar (- plus:*screen-offset*) 0 plus:*screen-offset* screenheight 127)
    (VWB_Bar plus:*ui-width* 0 plus:*screen-offset* screenheight 127)))

(define (plus:menu-clear)
  (VWB_Bar (- plus:*screen-offset*) 0 screenwidth screenheight BORDCOLOR))

(define (plus:menu-stripes row)
  (VWB_Bar (- plus:*screen-offset*) row screenwidth 24 0)
  (VWB_Hlin (- plus:*screen-offset*) (+ plus:*screen-offset* plus:*ui-width* -1) (+ row 22) STRIPE))

(define (plus:shape-page page)
  (cond ((< page PMSpriteStart)
         (let loop ((column 0))
           (when (< column 64)
             (FarScalePost (+ 128 column) 64 page column)
             (loop (+ column 1)))))
        ((< page PMSoundStart)
         (SimpleScaleShape (+ 160 plus:*screen-offset*) (- page PMSpriteStart) 64))
        ((< page (- ChunksInFile 1))
         (let ((data (PM_GetPage page))
               (baseline (+ WindowY WindowH -32)))
           (let loop ((index 0))
             (when (< index (bytevector-length data))
               (let ((value (truncate (/ (- (ref data index) 128) 4))))
                 (VWB_Vlin (min baseline (+ baseline value))
                           (max baseline (+ baseline value))
                           (+ WindowX 8 (quotient index 32)) 0))
               (loop (+ index 32))))))))

(when plus:*enabled*
  (let ((page-startup PM_Startup)
        (check-keys CheckKeys))
    (set! PM_Startup (lambda () (page-startup) (plus:startup)))
    (set! CheckKeys (lambda () (plus:check-keys) (check-keys))))
  (set! VL_LoadPalette plus:load-palette)
  (set! SetupGameLevel plus:setup-level)
  (set! PG13 plus:pg13)
  (set! GunAttack plus:gun-attack)
  (set! T_Shoot plus:shoot)
  (set! PollKeyboardMove plus:keyboard-move)
  (set! pc-render plus:pc-render)
  (set! SDL_SBPlaySeg plus:sb-segment)
  (set! SDL_SSPlaySample plus:ss-sample)
  (set! SetViewSize plus:view-size)
  (set! ShowViewSize plus:preview)
  (set! ThreeDRefresh plus:refresh)
  (set! VL_Plot plus:plot)
  (set! VL_Hlin plus:hline)
  (set! VH_Plot plus:clip-plot)
  (set! VH_Hlin plus:clip-hline)
  (set! VW_MarkUpdateBlock plus:mark-update)
  (set! VL_LatchToScreen plus:latch-to-screen)
  (set! VL_ScreenToScreen plus:screen-to-screen)
  (set! FizzleFade plus:fade)
  (set! DrawPlayBorderSides plus:border-sides)
  (set! DrawPlayBorder plus:border)
  (set! DrawPlayScreen plus:play-screen)
  (set! ClearSplitVWB plus:clear-split)
  (set! ClearMScreen plus:menu-clear)
  (set! DrawStripes plus:menu-stripes)
  (set! draw-shape-page plus:shape-page)

  (for-each
    (lambda (state) (setf! state 'action plus:shoot))
    (list s_grdshoot2 s_ofcshoot2
          s_ssshoot2 s_ssshoot4 s_ssshoot6 s_ssshoot8
          s_mutshoot1 s_mutshoot3
          s_fatshoot3 s_fatshoot4 s_fatshoot5 s_fatshoot6
          s_mechashoot2 s_mechashoot3 s_mechashoot4 s_mechashoot5 s_mechashoot6
          s_hitlershoot2 s_hitlershoot3 s_hitlershoot4 s_hitlershoot5 s_hitlershoot6))
  (for-each
    (lambda (boss)
      (let shots ((state (ref boss 'next)) (count 6))
        (when (> count 0)
          (setf! state 'action plus:shoot)
          (shots (ref state 'next) (- count 1)))))
    (list s_bossshoot1 s_gretelshoot1)))
