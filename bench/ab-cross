#!/usr/bin/env python3
"""Head-to-head jet benchmark vs lua, python, jsc, and jsc+jit for a single git ref.

Builds the jet ref in a temp worktree, then for each bench runs jet against
every available comparand (lua, python, jsc, jscjit), interleaving the
runs per iteration. Reports each rival's measured speed relative to jet and
whether a paired t-test on log time ratios finds a difference (5% level,
adjusted across all benchmarks and comparands). A missing source skips a bench for
that comparand only; missing .ss is fatal.

Usage:
    ./ab-cross [<ref>] [-n RUNS] [-b BENCH ...] [--keep]

Comparands resolve automatically: lua and python from PATH, jsc from the
macOS system JavaScriptCore helper. A comparand that cannot be found is a
fatal error; set its env var (LUA, PYTHON, JSC, JSCJIT) to the binary's path,
or to an empty string to skip that comparand. jsc runs with the JIT off
(LLInt); jscjit is the same binary with the JIT on, and JSCJIT overrides
which binary that is. Set JSC_VERSION when JSC or JSCJIT does not point into
Apple's JavaScriptCore framework.

Examples:
    ./ab-cross                       # use HEAD
    ./ab-cross HEAD~1
    ./ab-cross perf-branch -n 30 -b bench-fib -b bench-tak
"""
import argparse
import os
import plistlib
import random
import shutil
import statistics
import subprocess
import sys
import tempfile
import time
from pathlib import Path

from ab_stats import collect, holm_p, rival_percent, show_progress

HERE = Path(__file__).resolve().parent
REPO = HERE.parent
DEFAULT_BENCHES = sorted(p.stem for p in HERE.glob("bench-*.ss"))
SYSTEM_JSC = Path("/System/Library/Frameworks/JavaScriptCore.framework/Versions/A/Helpers/jsc")


def die(msg):
    print(f"error: {msg}", file=sys.stderr)
    sys.exit(1)


def run(cmd, **kw):
    r = subprocess.run(cmd, **kw)
    if r.returncode != 0:
        die(f"command failed (exit {r.returncode}): {' '.join(map(str, cmd))}")
    return r


def short(ref):
    r = subprocess.run(["git", "rev-parse", "--short", ref], cwd=REPO,
                       capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else ref


def build_ref(ref, dest):
    print(f"  building {ref} ({short(ref)}) at {dest} ...", flush=True)
    run(["git", "worktree", "add", "--detach", str(dest), ref], cwd=REPO,
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    cmd = ["make", "-j"]
    if "CXX" in os.environ:
        cmd.append(f"CXX={os.environ['CXX']}")
    run(cmd, cwd=dest, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    bin = dest / "build" / "jet"
    if not bin.exists():
        die(f"build did not produce {bin}")
    return bin


def remove_worktree(dest):
    subprocess.run(["git", "worktree", "remove", "--force", str(dest)],
                   cwd=REPO, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def time_run(cmd):
    s = time.perf_counter()
    r = subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    dt = time.perf_counter() - s
    if r.returncode != 0:
        die(f"benchmark exited {r.returncode}: {' '.join(map(str, cmd))}")
    return dt


def lua_version(lua):
    r = subprocess.run([lua, "-v"], capture_output=True, text=True)
    return (r.stderr.strip() or r.stdout.strip()).splitlines()[0]


def python_version(py):
    r = subprocess.run([py, "-V"], capture_output=True, text=True)
    return (r.stdout.strip() or r.stderr.strip()).splitlines()[0]


def jsc_version(jsc):
    if "JSC_VERSION" in os.environ:
        return os.environ["JSC_VERSION"] or "version unavailable"
    path = Path(jsc).resolve()
    framework = next((p for p in (path, *path.parents)
                      if p.name == "JavaScriptCore.framework"), None)
    if framework is None:
        return "version unavailable"
    plist = framework / "Resources" / "Info.plist"
    try:
        with plist.open("rb") as f:
            info = plistlib.load(f)
    except (OSError, plistlib.InvalidFileException):
        return "version unavailable"
    release = info.get("CFBundleShortVersionString")
    build = info.get("CFBundleVersion")
    if release and build and release != build:
        return f"{release}, build {build}"
    return str(release or build or "version unavailable")


def decimal_width(values):
    parts = [value.partition(".") for value in values]
    return max(len(whole) for whole, _, _ in parts), max(len(frac) for _, _, frac in parts)


def align_decimal(value, widths):
    whole, _, frac = value.partition(".")
    return f"{whole:>{widths[0]}}.{frac:<{widths[1]}}"


def main():
    ap = argparse.ArgumentParser(
        description="Head-to-head jet benchmark vs lua, python, jsc, and jsc+jit for a single git ref.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=__doc__)
    ap.add_argument("ref", nargs="?", default="HEAD",
                    help="git ref to build (default HEAD)")
    ap.add_argument("-n", "--runs", type=int, default=20,
                    help="paired trials per comparand per bench (default 20)")
    ap.add_argument("-w", "--warmups", type=int, default=3,
                    help="untimed runs per interpreter per bench (default 3)")
    ap.add_argument("--seed", type=int, help="random seed for run order (printed if omitted)")
    ap.add_argument("-b", "--bench", action="append",
                    help="restrict to specific bench (repeatable)")
    ap.add_argument("--keep", action="store_true",
                    help="keep temp worktree after run")
    args = ap.parse_args()
    if args.runs < 2 or args.warmups < 0:
        ap.error("--runs must be at least two and --warmups must be nonnegative")
    if args.seed is None:
        args.seed = random.SystemRandom().getrandbits(64)
    rng = random.Random(args.seed)

    benches = args.bench or DEFAULT_BENCHES

    def resolve(env_var, found, looked_in):
        if env_var in os.environ:
            return os.environ[env_var] or None
        if found is None:
            die(f"{env_var.lower()} not found in {looked_in}; "
                f"set {env_var}=/path/to/binary to point at it, or {env_var}= (empty) to skip it")
        return found

    lua = resolve("LUA", shutil.which("lua"), "PATH")
    py = resolve("PYTHON", shutil.which("python3") or shutil.which("python"), "PATH")
    # assumes macOS: jsc lives inside the system JavaScriptCore framework
    jsc = resolve("JSC", str(SYSTEM_JSC) if SYSTEM_JSC.exists() else None,
                  f"{SYSTEM_JSC} (a macOS path)")
    jscjit = os.environ["JSCJIT"] if "JSCJIT" in os.environ else jsc
    jscjit = jscjit or None
    if lua is None and py is None and jsc is None and jscjit is None:
        die("all comparands disabled (LUA/PYTHON/JSC/JSCJIT all empty)")

    r = subprocess.run(["git", "rev-parse", "--verify", f"{args.ref}^{{commit}}"],
                       cwd=REPO, capture_output=True)
    if r.returncode != 0:
        die(f"unknown git ref: {args.ref}")

    tmp = Path(tempfile.mkdtemp(prefix="ab-cross-"))
    wt = tmp / "jet"
    bin_jet = build_ref(args.ref, wt)

    print()
    print(f"  ref:    {args.ref} ({short(args.ref)})  →  {bin_jet}")
    if lua:
        print(f"  lua:    {lua}  ({lua_version(lua)})")
    if py:
        print(f"  python: {py}  ({python_version(py)})")
    if jsc:
        print(f"  jsc:    {jsc}  ({jsc_version(jsc)})")
    if jscjit:
        print(f"  jscjit: {jscjit}  ({jsc_version(jscjit)})")
    print(f"  {args.runs} pairs, {args.warmups} warmups; seed {args.seed}; "
          "whole-process time")
    print()

    sources_by_bench = {}
    for b in benches:
        ss_src = HERE / f"{b}.ss"
        if not ss_src.exists():
            die(f"missing scheme source: {ss_src}")
        sources = {}
        if lua and (HERE / f"{b}.lua").exists():
            sources["lua"] = HERE / f"{b}.lua"
        if py and (HERE / f"{b}.py").exists():
            sources["python"] = HERE / f"{b}.py"
        if jsc and (HERE / f"{b}.js").exists():
            sources["jsc"] = HERE / f"{b}.js"
        if jscjit and (HERE / f"{b}.js").exists():
            sources["jscjit"] = HERE / f"{b}.js"
        sources_by_bench[b] = (ss_src, sources)

    cmd_for = {
        "lua": lambda src: [lua, str(src)],
        "python": lambda src: [py, str(src)],
        "jsc": lambda src: [jsc, "--useJIT=false", str(HERE / "run-jsc-benchmark.js"),
                            "--", str(HERE / "js"), str(src), src.stem],
        "jscjit": lambda src: [jscjit, str(HERE / "run-jsc-benchmark.js"),
                               "--", str(HERE / "js"), str(src), src.stem],
    }

    rows = []
    results_by_lang = {"lua": [], "python": [], "jsc": [], "jscjit": []}
    total = sum(len(sources) for _, sources in sources_by_bench.values())
    completed = 0
    show_progress(0, total)
    for b in benches:
        ss_src, sources = sources_by_bench[b]
        if not sources:
            rows.append((b, None, None))
            continue
        for lang, src in sources.items():
            cmd_jet = [str(bin_jet), "run", str(ss_src)]
            cmd_rival = cmd_for[lang](src)
            result = collect(cmd_jet, cmd_rival, args.runs, time_run,
                             warmups=args.warmups, rng=rng)
            rows.append((b, lang, result))
            results_by_lang[lang].append(result)
            completed += 1
            show_progress(completed, total)

    tested = [result for _, _, result in rows if result is not None]
    adjusted = iter(holm_p([result.p for result in tested]))
    assessed = {b: {} for b in benches}
    for b, lang, result in rows:
        if result is not None:
            assessed[b][lang] = (result, next(adjusted) < 0.05)

    langs = [lang for lang, results in results_by_lang.items() if results]
    jet_times = {}
    for b in benches:
        samples = [t for result, _ in assessed[b].values() for t in result.primary_times]
        if samples:
            jet_times[b] = f"{statistics.median(samples)*1000:.1f}"

    jet_widths = decimal_width(list(jet_times.values())) if jet_times else (1, 1)
    jet_w = max(len("Jet"), sum(jet_widths) + 3)
    cells = {b: {} for b in benches}
    col_w = {}
    for lang in langs:
        times, percents = [], []
        for b in benches:
            if lang in assessed[b]:
                result, significant = assessed[b][lang]
                times.append(f"{result.baseline_median*1000:.1f}")
                if significant:
                    percents.append(rival_percent(result.ratio)[:-1])
        time_widths = decimal_width(times)
        percent_widths = decimal_width(percents) if percents else (1, 1)
        for b in benches:
            if lang not in assessed[b]:
                cells[b][lang] = "—"
                continue
            result, significant = assessed[b][lang]
            time = align_decimal(f"{result.baseline_median*1000:.1f}", time_widths)
            if significant:
                percent = align_decimal(rival_percent(result.ratio)[:-1], percent_widths)
                direction = "slower" if result.ratio < 1 else "faster"
                change = f"{percent}% {direction}"
            else:
                change = "unclear"
            cells[b][lang] = f"{time}ms ({change})"
        col_w[lang] = max(len(lang), *(len(cells[b][lang]) for b in benches))

    name_w = max(len("bench"), *(len(b) for b in benches))
    print()
    header = (f"  {'bench':<{name_w}} | {'Jet':^{jet_w}}" +
              "".join(f" | {lang:^{col_w[lang]}}" for lang in langs))
    print(header.rstrip())
    print("  " + "─" * (len(header) - 2))
    for b in benches:
        jet = f"{align_decimal(jet_times[b], jet_widths)}ms" if b in jet_times else "—"
        print(f"  {b:<{name_w}} | {jet:>{jet_w}}" +
              "".join(f" | {cells[b][lang]:<{col_w[lang]}}" for lang in langs))

    print()
    summaries = [(lang, results, statistics.geometric_mean(result.ratio for result in results))
                 for lang, results in results_by_lang.items() if len(results) > 1]
    if summaries:
        print("  overall (geomean)")
        lang_w = max(len(lang) for lang, _, _ in summaries)
        percent_w = max(len(rival_percent(gm)) for _, _, gm in summaries)
        for lang, results, gm in summaries:
            change = ("0% change" if abs(gm - 1) < 1e-12 else
                      f"{rival_percent(gm):>{percent_w}} {'slower' if gm < 1 else 'faster'}")
            print(f"    {lang:<{lang_w}} is  {change} ({len(results)} benches)")
        print()
    if tested:
        print("  Benchmark results marked faster/slower meet the 5% significance "
              "cutoff after adjustment.")

    if not args.keep:
        remove_worktree(wt)
    else:
        print(f"\n  worktree kept: {wt}")


if __name__ == "__main__":
    main()
