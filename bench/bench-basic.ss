;; Port of the ARES-6 "Basic" benchmark: a BASIC interpreter.
;; A coroutine drives each program and yields PRINT output; recursive-descent
;; parser; case-insensitive variable maps; nested vectors for DIM.

;; ---------------- structs ----------------

(define token-t (struct 'token '(kind text value src-line user-line)))
(define EOF-TOKEN (token-t 'eof "<end of file>" #f 0 0))

(define binop-t (struct 'binop '(ev left right)))
(define neg-t (struct 'neg '(ev term)))
(define const-t (struct 'const '(ev value)))
(define var-t (struct 'varref '(ev name parameters)))
(define strvar-t (struct 'strvar '(ev name)))

(define stmt-t (struct 'stmt '(kind proc line src-line target name parameters expression variable
                               condition targets initial limit step items side-var side-limit side-step)))
(define item-t (struct 'print-item '(kind value)))
(define dim-item-t (struct 'dim-item '(name bounds)))

(define number-value-t (struct 'number-value '(value)))
(define number-array-t (struct 'number-array '(array dim)))
(define native-fn-t (struct 'native-fn '(arity fn)))
(define number-fn-t (struct 'number-fn '(params code)))

(define parser-t (struct 'parser '(iter pushback program)))
(define program-t (struct 'program '(statements data base)))
(define state-t (struct 'state '(values string-values statement next-line sub-stack data-index
                                 program rng yield)))

;; ---------------- helpers ----------------

(define (die text)
  (displayn (string-append "bad: " text))
  (exit 1))

(define (abort state text) (die text))

(define (validate state ok text)
  (unless ok (abort state text)))

(define (sign x)
  (cond ((> x 0) 1) ((< x 0) -1) (else 0)))

(define (make-list n fill)
  (let loop ((i 0) (acc '()))
    (if (= i n) acc (loop (+ i 1) (cons fill acc)))))

(define (list-nth lst n) (car (drop lst n)))

(define (hashmap-max-key m)
  (let ((cur (%iter m)))
    (let loop ((best 0))
      (%if/next! ((k v) cur) (loop (if (> k best) k best)) best))))

(define (hashmap-copy m)
  (let ((out (hashmap)) (cur (%iter m)))
    (let loop ()
      (%if/next! ((k v) cur) (begin (setf! out k v) (loop)) out))))

;; ---------------- RNG: Robert Jenkins' 32-bit integer hash ----------------

;; Jet's bitwise ops are 32-bit signed, so the unsigned 32-bit state is kept in [0, 2^32) with
;; modulo arithmetic; uxor renormalizes the signed xor result into that range.
(define (u32 x) (modulo x 4294967296))
(define (uxor a b) (u32 (bitwise-xor a b)))

(define (make-rng seed0)
  (let ((seed seed0))
    (lambda ()
      (set! seed (u32 (+ seed 2127912214 (* seed 4096))))
      (set! seed (uxor (uxor seed 3345072700) (floor (/ seed 524288))))
      (set! seed (u32 (+ seed 374761393 (* seed 32))))
      (set! seed (uxor (u32 (+ seed 3550635116)) (u32 (* seed 512))))
      (set! seed (u32 (+ seed 4251993797 (* seed 8))))
      (set! seed (uxor (uxor seed 3042594569) (floor (/ seed 65536))))
      (/ (modulo seed 268435456) 268435456))))

;; ---------------- values ----------------

(define (make-number-array dims)
  (number-array-t (allocate-array dims) dims))

(define (allocate-array dims)
  (let* ((count (floor (car dims)))
         (vec (make-vector count #f)))
    (let loop ((i 0))
      (when (< i count)
        (setf! vec i (if (null? (cdr dims)) (number-value-t 0) (allocate-array (cdr dims))))
        (loop (+ i 1))))
    vec))

(define (array-left-apply arr state params)
  (unless (= (length (ref arr 'dim)) (length params))
    (abort state "wrong number of array arguments"))
  (let ((base (ref (ref state 'program) 'base)))
    (let loop ((result (ref arr 'array)) (ps params))
      (if (null? ps)
          result
          (let ((index (floor (car ps))))
            (unless (and (>= index base) (< index (vector-length result)))
              (abort state (string-append "Index out of bounds: " (number->string index))))
            (loop (ref result index) (cdr ps)))))))

(define (value-apply v state params)
  (cond ((isa? v number-value-t)
         (validate state (null? params) "Should not pass arguments to simple numeric variables")
         (ref v 'value))
        ((isa? v number-array-t)
         (ref (array-left-apply v state params) 'value))
        ((isa? v native-fn-t)
         (unless (= (ref v 'arity) (length params)) (abort state "wrong number of arguments"))
         (apply (ref v 'fn) params))
        ((isa? v number-fn-t)
         (unless (= (length (ref v 'params)) (length params)) (abort state "Wrong number of arguments"))
         (let* ((old (ref state 'values))
                (new (hashmap-copy old)))
           (setf! state 'values new)
           (let loop ((names (ref v 'params)) (vs params))
             (unless (null? names)
               (setf! new (ascii-downcase (car names)) (car vs))
               (loop (cdr names) (cdr vs))))
           (let ((result (evaluate (ref v 'code) state)))
             (setf! state 'values old)
             result)))
        (else (abort state "bad value"))))

(define (value-left-apply v state params)
  (cond ((isa? v number-value-t)
         (validate state (null? params) "Should not pass arguments to simple numeric variables")
         v)
        ((isa? v number-array-t) (array-left-apply v state params))
        (else (abort state "Cannot use a native function as an lvalue"))))

;; ---------------- state ----------------

(define (add-native st name arity fn)
  (setf! (ref st 'values) name (native-fn-t arity fn)))

(define (new-state program)
  (let ((st (state-t (hashmap) (hashmap) #f 0 '() 0 program (make-rng 49734321) #f)))
    (add-native st "abs" 1 abs)
    (add-native st "atn" 1 atan)
    (add-native st "cos" 1 cos)
    (add-native st "exp" 1 exp)
    (add-native st "int" 1 floor)
    (add-native st "log" 1 log)
    (add-native st "rnd" 0 (lambda () ((ref st 'rng))))
    (add-native st "sgn" 1 sign)
    (add-native st "sin" 1 sin)
    (add-native st "sqr" 1 sqrt)
    (add-native st "tan" 1 tan)
    st))

(define (state-get-value state name n-params)
  (let* ((vals (ref state 'values))
         (key (ascii-downcase name))
         (existing (ref vals key :default #f)))
    (if existing
        existing
        (let ((v (if (= n-params 0)
                     (number-value-t 0)
                     (make-number-array (make-list n-params 11)))))
          (setf! vals key v)
          v))))

;; ---------------- expression evaluators ----------------

(define (evaluate node state) ((ref node 'ev) node state))

(define (eval-params node state)
  (map (lambda (p) (evaluate p state)) (ref node 'parameters)))

(define (e-number-apply node state)
  (let ((params (eval-params node state)))
    (value-apply (state-get-value state (ref node 'name) (length params)) state params)))

(define (e-variable node state)
  (let ((params (eval-params node state)))
    (value-left-apply (state-get-value state (ref node 'name) (length params)) state params)))

(define (e-const node state) (ref node 'value))
(define (e-pow node state) (expt (evaluate (ref node 'left) state) (evaluate (ref node 'right) state)))
(define (e-mul node state) (* (evaluate (ref node 'left) state) (evaluate (ref node 'right) state)))
(define (e-div node state) (/ (evaluate (ref node 'left) state) (evaluate (ref node 'right) state)))
(define (e-neg node state) (- 0 (evaluate (ref node 'term) state)))
(define (e-add node state) (+ (evaluate (ref node 'left) state) (evaluate (ref node 'right) state)))
(define (e-sub node state) (- (evaluate (ref node 'left) state) (evaluate (ref node 'right) state)))

(define (e-string-var node state)
  (let ((value (ref (ref state 'string-values) (ascii-downcase (ref node 'name)) :default #f)))
    (unless value (abort state (string-append "Could not find string variable " (ref node 'name))))
    value))

(define (e-equals node state)
  (equal? (evaluate (ref node 'left) state) (evaluate (ref node 'right) state)))
(define (e-not-equals node state)
  (not (equal? (evaluate (ref node 'left) state) (evaluate (ref node 'right) state))))
(define (e-less-than node state)
  (< (evaluate (ref node 'left) state) (evaluate (ref node 'right) state)))
(define (e-greater-than node state)
  (> (evaluate (ref node 'left) state) (evaluate (ref node 'right) state)))
(define (e-less-equal node state)
  (<= (evaluate (ref node 'left) state) (evaluate (ref node 'right) state)))
(define (e-greater-equal node state)
  (>= (evaluate (ref node 'left) state) (evaluate (ref node 'right) state)))

;; ---------------- statement processors ----------------

(define (s-goto st state) (setf! state 'next-line (ref st 'target)))

(define (s-gosub st state)
  (setf! state 'sub-stack (cons (ref state 'next-line) (ref state 'sub-stack)))
  (setf! state 'next-line (ref st 'target)))

(define (s-def st state)
  (let ((key (ascii-downcase (ref st 'name))))
    (validate state (not (ref (ref state 'values) key :default #f)) "Cannot redefine function")
    (setf! (ref state 'values) key (number-fn-t (ref st 'parameters) (ref st 'expression)))))

(define (s-let st state)
  (let ((lhs (evaluate (ref st 'variable) state)))
    (setf! lhs 'value (evaluate (ref st 'expression) state))))

(define (s-if st state)
  (when (evaluate (ref st 'condition) state)
    (setf! state 'next-line (ref st 'target))))

(define (s-return st state)
  (validate state (not (null? (ref state 'sub-stack))) "Not in a subroutine")
  (setf! state 'next-line (car (ref state 'sub-stack)))
  (setf! state 'sub-stack (cdr (ref state 'sub-stack))))

(define (s-stop st state) (setf! state 'next-line #f))

(define (s-on st state)
  (let ((index (evaluate (ref st 'expression) state)))
    (unless (and (>= index 1) (<= index (length (ref st 'targets))))
      (abort state (string-append "Index out of bounds: " (number->string index))))
    (setf! state 'next-line (list-nth (ref st 'targets) (- (floor index) 1)))))

(define (for-should-stop for-st)
  (> (* (- (ref (ref for-st 'side-var) 'value) (ref for-st 'side-limit))
        (sign (ref for-st 'side-step)))
     0))

(define (s-for st state)
  (let ((var (value-left-apply (state-get-value state (ref st 'variable) 0) state '()))
        (initial (evaluate (ref st 'initial) state))
        (limit (evaluate (ref st 'limit) state))
        (step (evaluate (ref st 'step) state)))
    (setf! st 'side-var var)
    (setf! st 'side-limit limit)
    (setf! st 'side-step step)
    (setf! var 'value initial)
    (when (for-should-stop st)
      (setf! state 'next-line (+ (ref (ref st 'target) 'line) 1)))))

(define (s-next st state)
  (let* ((for-st (ref st 'target))
         (var (ref for-st 'side-var)))
    (setf! var 'value (+ (ref var 'value) (ref for-st 'side-step)))
    (unless (for-should-stop for-st)
      (setf! state 'next-line (+ (ref for-st 'line) 1)))))

(define (pad-to str width)
  (if (= (modulo (string-length str) width) 0)
      str
      (pad-to (string-append str " ") width)))

(define (s-print st state)
  (let loop ((items (ref st 'items)) (str ""))
    (if (null? items)
        ((ref state 'yield) str)
        (let* ((item (car items))
               (kind (ref item 'kind)))
          (cond ((eq? kind 'comma) (loop (cdr items) (pad-to str 14)))
                ((eq? kind 'tab)
                 (let* ((v (evaluate (ref item 'value) state))
                        (w (max (floor (+ v 0.5)) 1)))
                   (loop (cdr items) (pad-to str w))))
                (else
                 (let ((v (evaluate (ref item 'value) state)))
                   (loop (cdr items)
                         (string-append str (if (string? v) v (number->string v)))))))))))

(define (s-input st state) (abort state "INPUT is not supported"))

(define (s-read st state)
  (let loop ((items (ref st 'items)))
    (unless (null? items)
      (let ((data (ref (ref state 'program) 'data)))
        (validate state (< (ref state 'data-index) (length data))
                  "Attempting to read past the end of data")
        (let ((lhs (evaluate (car items) state)))
          (setf! lhs 'value (list-nth data (ref state 'data-index))))
        (setf! state 'data-index (+ (ref state 'data-index) 1)))
      (loop (cdr items)))))

(define (s-restore st state) (setf! state 'data-index 0))

(define (s-dim st state)
  (let loop ((items (ref st 'items)))
    (unless (null? items)
      (let* ((item (car items))
             (key (ascii-downcase (ref item 'name))))
        (validate state (not (ref (ref state 'values) key :default #f)) "Variable already exists")
        (validate state (> (length (ref item 'bounds)) 0) "Dim statement is for arrays")
        (setf! (ref state 'values) key
               (make-number-array (map (lambda (b) (+ b 1)) (ref item 'bounds)))))
      (loop (cdr items)))))

(define (s-randomize st state)
  (setf! state 'rng (make-rng (floor (* (random) 4294967296)))))

(define (s-end st state) (setf! state 'next-line #f))

(define (program-run program state)
  (let ((statements (ref program 'statements))
        (max-line (hashmap-max-key (ref program 'statements))))
    (let loop ()
      (let ((nl (ref state 'next-line)))
        (when nl
          (validate state (<= nl max-line) "Went out of bounds of the program")
          (let ((st (ref statements nl :default #f)))
            (setf! state 'next-line (+ nl 1))
            (when (and st (ref st 'proc))
              (setf! state 'statement st)
              ((ref st 'proc) st state)))
          (loop))))))

;; ---------------- lexer (lazy, via coroutine) ----------------

(define KEYWORDS
  (hashset "base" "data" "def" "dim" "end" "for" "go" "gosub" "goto" "if" "input" "let" "next"
           "on" "option" "print" "randomize" "read" "restore" "return" "step" "stop" "sub"
           "then" "to"))

(define OP-CHARS (hashset #\- #\+ #\* #\/ #\^ #\( #\) #\, #\$ #\; #\= #\< #\>))

(define (split-lines s)
  (let ((n (string-length s)))
    (let loop ((start 0) (i 0) (acc '()))
      (cond ((= i n) (reverse (cons (substring s start i) acc)))
            ((char=? (string-ref s i) #\newline)
             (loop (+ i 1) (+ i 1) (cons (substring s start i) acc)))
            (else (loop start (+ i 1) acc))))))

(define (skip-ws line p len)
  (if (and (< p len) (char-whitespace? (string-ref line p))) (skip-ws line (+ p 1) len) p))

(define (scan-digits line p len)
  (if (and (< p len) (char-numeric? (string-ref line p))) (scan-digits line (+ p 1) len) p))

(define (ident-start? ch) (or (char-alphabetic? ch) (char=? ch #\_)))

(define (ident-end line p len)
  (if (and (< p len)
           (let ((c (string-ref line p)))
             (or (char-alphabetic? c) (char-numeric? c) (char=? c #\_))))
      (ident-end line (+ p 1) len)
      p))

(define (scan-string line p len)
  (let loop ((i (+ p 1)) (acc ""))
    (if (>= i len)
        (list acc (+ i 1))
        (let ((ch (string-ref line i)))
          (if (char=? ch #\")
              (if (and (< (+ i 1) len) (char=? (string-ref line (+ i 1)) #\"))
                  (loop (+ i 2) (string-append acc "\""))
                  (list acc (+ i 1)))
              (loop (+ i 1) (string-append acc (string ch))))))))

(define (lex-line yield line src-line)
  (let* ((len (string-length line))
         (p0 (skip-ws line 0 len))
         (p1 (scan-digits line p0 len)))
    (when (= p1 p0) (die (string-append "Expect line number: " (substring line p0 len))))
    (let* ((text (substring line p0 p1))
           (user-line (string->number text)))
      (yield (token-t 'user-line text user-line src-line user-line))
      (let loop ((p (skip-ws line p1 len)))
        (if (>= p len)
            (yield (token-t 'newline "\n" #f src-line user-line))
            (let ((ch (string-ref line p)))
              (cond
                ((ident-start? ch)
                 (let* ((e (ident-end line (+ p 1) len))
                        (word (substring line p e))
                        (kind (if (ref KEYWORDS (ascii-downcase word)) 'keyword 'identifier)))
                   (yield (token-t kind word #f src-line user-line))
                   (loop (skip-ws line e len))))
                ((or (char-numeric? ch)
                     (and (char=? ch #\.) (< (+ p 1) len) (char-numeric? (string-ref line (+ p 1)))))
                 (let* ((e (if (char=? ch #\.)
                               (scan-digits line (+ p 1) len)
                               (let ((e1 (scan-digits line p len)))
                                 (if (and (< e1 len) (char=? (string-ref line e1) #\.))
                                     (scan-digits line (+ e1 1) len)
                                     e1))))
                        (ntext (substring line p e)))
                   (yield (token-t 'number ntext (string->number ntext) src-line user-line))
                   (loop (skip-ws line e len))))
                ((char=? ch #\")
                 (let ((r (scan-string line p len)))
                   (yield (token-t 'string (first r) (first r) src-line user-line))
                   (loop (skip-ws line (second r) len))))
                (else
                 (let ((op (if (and (< (+ p 1) len)
                                    (let ((two (substring line p (+ p 2))))
                                      (or (string=? two "<>") (string=? two "<=")
                                          (string=? two ">="))))
                               (substring line p (+ p 2))
                               (if (ref OP-CHARS ch) (string ch) #f))))
                   (unless op (die (string-append "Cannot lex token: " (substring line p len))))
                   (yield (token-t 'operator op #f src-line user-line))
                   (loop (skip-ws line (+ p (string-length op)) len)))))))))))

(define (lex-source source yield)
  (let loop ((lines (split-lines source)) (n 1))
    (unless (null? lines)
      (lex-line yield (car lines) n)
      (loop (cdr lines) (+ n 1)))))

;; ---------------- parser ----------------

(define (next-token ps)
  (let ((pb (ref ps 'pushback)))
    (if (null? pb)
        (coro/next (ref ps 'iter) EOF-TOKEN)
        (begin (setf! ps 'pushback (cdr pb)) (car pb)))))

(define (push-token ps t) (setf! ps 'pushback (cons t (ref ps 'pushback))))

(define (peek-token ps)
  (let ((t (next-token ps)))
    (push-token ps t)
    t))

(define (peek-text ps) (ref (peek-token ps) 'text))

(define (consume-kind ps kind)
  (let ((t (next-token ps)))
    (unless (eq? (ref t 'kind) kind)
      (die (string-append "unexpected token: " (ref t 'text))))
    t))

(define (consume-word ps word)
  (let ((t (next-token ps)))
    (unless (string=? (ascii-downcase (ref t 'text)) word)
      (die (string-append "expected " word " but got: " (ref t 'text))))
    t))

(define (all-digits? s)
  (let ((n (string-length s)))
    (and (> n 0)
         (let loop ((i 0))
           (or (= i n) (and (char-numeric? (string-ref s i)) (loop (+ i 1))))))))

(define (parse-non-negative-integer ps)
  (let ((t (next-token ps)))
    (unless (and (eq? (ref t 'kind) 'number) (all-digits? (ref t 'text)))
      (die (string-append "expected a line number but got: " (ref t 'text))))
    (ref t 'value)))

(define (parse-call-params ps)
  (if (string=? (peek-text ps) "(")
      (let loop ((acc '()))
        (next-token ps)
        (let ((acc2 (cons (parse-numeric-expression ps) acc)))
          (if (string=? (peek-text ps) ",")
              (loop acc2)
              (begin (consume-word ps ")") (reverse acc2)))))
      '()))

(define (parse-variable ps)
  (let ((name (ref (consume-kind ps 'identifier) 'text)))
    (var-t e-variable name (parse-call-params ps))))

(define (parse-primary ps)
  (let ((token (next-token ps)))
    (cond ((eq? (ref token 'kind) 'identifier)
           (var-t e-number-apply (ref token 'text) (parse-call-params ps)))
          ((eq? (ref token 'kind) 'number) (const-t e-const (ref token 'value)))
          ((and (eq? (ref token 'kind) 'operator) (string=? (ref token 'text) "("))
           (let ((result (parse-numeric-expression ps)))
             (consume-word ps ")")
             result))
          (else (die (string-append "expected identifier, number, or (, but got: "
                                    (ref token 'text)))))))

(define (parse-factor ps)
  (let loop ((primary (parse-primary ps)))
    (if (string=? (peek-text ps) "^")
        (begin (next-token ps) (loop (binop-t e-pow primary (parse-primary ps))))
        primary)))

(define (parse-term ps)
  (let loop ((factor (parse-factor ps)))
    (let ((s (peek-text ps)))
      (cond ((string=? s "*") (next-token ps) (loop (binop-t e-mul factor (parse-factor ps))))
            ((string=? s "/") (next-token ps) (loop (binop-t e-div factor (parse-factor ps))))
            (else factor)))))

(define (parse-numeric-expression ps)
  (let* ((s0 (peek-text ps))
         (negate (string=? s0 "-")))
    (when (or (string=? s0 "+") (string=? s0 "-")) (next-token ps))
    (let loop ((term (let ((t (parse-term ps))) (if negate (neg-t e-neg t) t))))
      (let ((s (peek-text ps)))
        (cond ((string=? s "+") (next-token ps) (loop (binop-t e-add term (parse-term ps))))
              ((string=? s "-") (next-token ps) (loop (binop-t e-sub term (parse-term ps))))
              (else term))))))

(define (parse-constant ps)
  (let ((s (peek-text ps)))
    (cond ((string=? s "+") (next-token ps) (ref (consume-kind ps 'number) 'value))
          ((string=? s "-") (next-token ps) (- 0 (ref (consume-kind ps 'number) 'value)))
          ((is-string-expression ps) (ref (consume-kind ps 'string) 'value))
          (else (ref (consume-kind ps 'number) 'value)))))

(define (parse-string-expression ps)
  (let ((token (next-token ps)))
    (cond ((eq? (ref token 'kind) 'string) (const-t e-const (ref token 'value)))
          ((eq? (ref token 'kind) 'identifier)
           (consume-word ps "$")
           (strvar-t e-string-var (ref token 'text)))
          (else (die (string-append "expected string expression but got " (ref token 'text)))))))

(define (is-string-expression ps)
  (let ((token (next-token ps)))
    (cond ((eq? (ref token 'kind) 'string) (push-token ps token) #t)
          ((eq? (ref token 'kind) 'identifier)
           (let ((result (string=? (peek-text ps) "$")))
             (push-token ps token)
             result))
          (else (push-token ps token) #f))))

(define (parse-relational-expression ps)
  (if (is-string-expression ps)
      (let* ((left (parse-string-expression ps))
             (text (ref (next-token ps) 'text))
             (ev (cond ((string=? text "=") e-equals)
                       ((string=? text "<>") e-not-equals)
                       (else (die (string-append "expected a string comparison operator but got: "
                                                 text))))))
        (binop-t ev left (parse-string-expression ps)))
      (let* ((left (parse-numeric-expression ps))
             (text (ref (next-token ps) 'text))
             (ev (cond ((string=? text "=") e-equals)
                       ((string=? text "<>") e-not-equals)
                       ((string=? text "<") e-less-than)
                       ((string=? text ">") e-greater-than)
                       ((string=? text "<=") e-less-equal)
                       ((string=? text ">=") e-greater-equal)
                       (else (die (string-append "expected a numeric comparison operator but got: "
                                                 text))))))
        (binop-t ev left (parse-numeric-expression ps)))))

(define (new-stmt line)
  (stmt-t #f #f line #f #f #f #f #f #f #f #f #f #f #f #f #f #f #f))

(define (parse-goto ps st)
  (setf! st 'kind 'goto)
  (setf! st 'proc s-goto)
  (setf! st 'target (parse-non-negative-integer ps)))

(define (parse-gosub ps st)
  (setf! st 'kind 'gosub)
  (setf! st 'proc s-gosub)
  (setf! st 'target (parse-non-negative-integer ps)))

(define (parse-statement ps)
  (let* ((line-token (consume-kind ps 'user-line))
         (st (new-stmt (ref line-token 'user-line)))
         (prog (ref ps 'program)))
    (setf! (ref prog 'statements) (ref st 'line) st)
    (let ((command (next-token ps)))
      (setf! st 'src-line (ref command 'src-line))
      (unless (eq? (ref command 'kind) 'keyword)
        (die (string-append "expected command but got: " (ref command 'text))))
      (let* ((kw (ascii-downcase (ref command 'text)))
             (early
              (cond
                ((string=? kw "def")
                 (setf! st 'kind 'def)
                 (setf! st 'proc s-def)
                 (setf! st 'name (ref (consume-kind ps 'identifier) 'text))
                 (setf! st 'parameters
                        (if (string=? (peek-text ps) "(")
                            (let loop ((acc '()))
                              (next-token ps)
                              (let ((acc2 (cons (ref (consume-kind ps 'identifier) 'text) acc)))
                                (if (string=? (peek-text ps) ",") (loop acc2) (reverse acc2))))
                            '()))
                 (setf! st 'expression (parse-numeric-expression ps))
                 #f)
                ((string=? kw "let")
                 (setf! st 'kind 'let)
                 (setf! st 'proc s-let)
                 (setf! st 'variable (parse-variable ps))
                 (consume-word ps "=")
                 (setf! st 'expression (parse-numeric-expression ps))
                 #f)
                ((string=? kw "go")
                 (let ((nxt (next-token ps)))
                   (cond ((string=? (ref nxt 'text) "to") (parse-goto ps st))
                         ((string=? (ref nxt 'text) "sub") (parse-gosub ps st))
                         (else (die (string-append "expected to or sub but got: "
                                                   (ref nxt 'text))))))
                 #f)
                ((string=? kw "goto") (parse-goto ps st) #f)
                ((string=? kw "gosub") (parse-gosub ps st) #f)
                ((string=? kw "if")
                 (setf! st 'kind 'if)
                 (setf! st 'proc s-if)
                 (setf! st 'condition (parse-relational-expression ps))
                 (consume-word ps "then")
                 (setf! st 'target (parse-non-negative-integer ps))
                 #f)
                ((string=? kw "return") (setf! st 'kind 'return) (setf! st 'proc s-return) #f)
                ((string=? kw "stop") (setf! st 'kind 'stop) (setf! st 'proc s-stop) #f)
                ((string=? kw "on")
                 (setf! st 'kind 'on)
                 (setf! st 'proc s-on)
                 (setf! st 'expression (parse-numeric-expression ps))
                 (if (string=? (peek-text ps) "go")
                     (begin (consume-word ps "go") (consume-word ps "to"))
                     (consume-word ps "goto"))
                 (setf! st 'targets
                        (let loop ((acc (list (parse-non-negative-integer ps))))
                          (if (string=? (peek-text ps) ",")
                              (begin (next-token ps)
                                     (loop (cons (parse-non-negative-integer ps) acc)))
                              (reverse acc))))
                 #f)
                ((string=? kw "for")
                 (setf! st 'kind 'for)
                 (setf! st 'proc s-for)
                 (setf! st 'variable (ref (consume-kind ps 'identifier) 'text))
                 (consume-word ps "=")
                 (setf! st 'initial (parse-numeric-expression ps))
                 (consume-word ps "to")
                 (setf! st 'limit (parse-numeric-expression ps))
                 (setf! st 'step
                        (if (string=? (peek-text ps) "step")
                            (begin (next-token ps) (parse-numeric-expression ps))
                            (const-t e-const 1)))
                 (consume-kind ps 'newline)
                 (let ((last (parse-statements ps)))
                   (unless (eq? (ref last 'kind) 'next) (die "expected next statement"))
                   (unless (string=? (ref last 'variable) (ref st 'variable))
                     (die (string-append "expected next for " (ref st 'variable))))
                   (setf! last 'target st)
                   (setf! st 'target last))
                 #t)
                ((string=? kw "next")
                 (setf! st 'kind 'next)
                 (setf! st 'proc s-next)
                 (setf! st 'variable (ref (consume-kind ps 'identifier) 'text))
                 #f)
                ((string=? kw "print")
                 (setf! st 'kind 'print)
                 (setf! st 'proc s-print)
                 (setf! st 'items
                        (let loop ((acc '()))
                          (let ((s (peek-text ps)))
                            (cond ((string=? s ",")
                                   (next-token ps)
                                   (loop (cons (item-t 'comma #f) acc)))
                                  ((string=? s ";") (next-token ps) (loop acc))
                                  ((string=? s "tab")
                                   (next-token ps)
                                   (consume-word ps "(")
                                   (loop (cons (item-t 'tab (parse-numeric-expression ps)) acc)))
                                  ((string=? s "\n") (reverse acc))
                                  (else
                                   (if (is-string-expression ps)
                                       (loop (cons (item-t 'string (parse-string-expression ps))
                                                   acc))
                                       (loop (cons (item-t 'number (parse-numeric-expression ps))
                                                   acc))))))))
                 #f)
                ((string=? kw "input")
                 (setf! st 'kind 'input)
                 (setf! st 'proc s-input)
                 (setf! st 'items
                        (let loop ((acc (list (parse-variable ps))))
                          (if (string=? (peek-text ps) ",")
                              (begin (next-token ps) (loop (cons (parse-variable ps) acc)))
                              (reverse acc))))
                 #f)
                ((string=? kw "read")
                 (setf! st 'kind 'read)
                 (setf! st 'proc s-read)
                 (setf! st 'items
                        (let loop ((acc (list (parse-variable ps))))
                          (if (string=? (peek-text ps) ",")
                              (begin (next-token ps) (loop (cons (parse-variable ps) acc)))
                              (reverse acc))))
                 #f)
                ((string=? kw "restore") (setf! st 'kind 'restore) (setf! st 'proc s-restore) #f)
                ((string=? kw "data")
                 (let loop ()
                   (setf! prog 'data (append (ref prog 'data) (list (parse-constant ps))))
                   (when (string=? (peek-text ps) ",")
                     (next-token ps)
                     (loop)))
                 #f)
                ((string=? kw "dim")
                 (setf! st 'kind 'dim)
                 (setf! st 'proc s-dim)
                 (setf! st 'items
                        (let loop ((acc '()))
                          (let ((name (ref (consume-kind ps 'identifier) 'text)))
                            (consume-word ps "(")
                            (let* ((b1 (parse-non-negative-integer ps))
                                   (bounds (if (string=? (peek-text ps) ",")
                                               (begin (next-token ps)
                                                      (list b1 (parse-non-negative-integer ps)))
                                               (list b1))))
                              (consume-word ps ")")
                              (let ((acc2 (cons (dim-item-t name bounds) acc)))
                                (if (string=? (peek-text ps) ",")
                                    (begin (consume-word ps ",") (loop acc2))
                                    (reverse acc2)))))))
                 #f)
                ((string=? kw "option")
                 (consume-word ps "base")
                 (let ((base (parse-non-negative-integer ps)))
                   (unless (or (= base 0) (= base 1)) (die "unexpected base"))
                   (setf! prog 'base base))
                 #f)
                ((string=? kw "randomize")
                 (setf! st 'kind 'randomize)
                 (setf! st 'proc s-randomize)
                 #f)
                ((string=? kw "end") (setf! st 'kind 'end) (setf! st 'proc s-end) #f)
                (else (die (string-append "unexpected command: " (ref command 'text)))))))
        (unless early (consume-kind ps 'newline))
        st))))

(define (parse-statements ps)
  (let loop ()
    (let ((st (parse-statement ps)))
      (if (or (eq? (ref st 'kind) 'next) (eq? (ref st 'kind) 'end))
          st
          (loop)))))

(define (make-program ps)
  (let ((last (parse-statements ps)))
    (unless (eq? (ref last 'kind) 'end) (die "expected end"))
    (ref ps 'program)))

;; ---------------- glue ----------------

(define HALT '%basic-halt)

(define (prepare src)
  (let* ((tokens (let/coro yield () (lex-source src yield) EOF-TOKEN))
         (ps (parser-t tokens '() (program-t (hashmap) '() 0)))
         (program (make-program ps)))
    (list program (new-state program))))

(define (simulate program state)
  (let ((co (let/coro yield ()
              (setf! state 'yield yield)
              (program-run program state)
              HALT)))
    (let loop ((acc '()))
      (let ((r (coro/next co HALT)))
        (if (eq? r HALT)
            (apply string-append (reverse acc))
            (loop (cons "\n" (cons r acc))))))))

;; golden BASIC programs and their expected output (generated from the reference)
