#!/usr/bin/env python3
"""Head-to-head benchmark of two git refs.

Builds both refs in temp worktrees and times paired subprocess runs with
randomized balanced order. Reports the measured speed change and whether a
paired t-test on log time ratios finds a difference (5% level, adjusted across
benchmarks).

Usage:
    ./ab-compare <ref-old> <ref-new> [-n RUNS] [-b BENCH ...] [--keep]

Examples:
    ./ab-compare HEAD~1 HEAD
    ./ab-compare main perf-branch -n 30
    ./ab-compare 5fc6008 2105bcf -b bench-fib -b bench-tak
"""
import argparse
import os
import random
import statistics
import subprocess
import sys
import tempfile
import time
from pathlib import Path

from ab_stats import collect, holm_p, percent_result, show_progress

HERE = Path(__file__).resolve().parent
REPO = HERE.parent
DEFAULT_BENCHES = sorted(p.stem for p in HERE.glob("bench-*.ss"))


def die(msg):
    print(f"error: {msg}", file=sys.stderr)
    sys.exit(1)


def run(cmd, **kw):
    result = subprocess.run(cmd, **kw)
    if result.returncode != 0:
        if result.stdout:
            print(result.stdout, end="", file=sys.stderr)
        die(f"command failed (exit {result.returncode}): {' '.join(map(str, cmd))}")
    return result


def short(ref):
    r = subprocess.run(["git", "rev-parse", "--short", ref], cwd=REPO,
                       capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else ref


def build_ref(ref, dest):
    print(f"  building {ref} ({short(ref)}) at {dest} ...", flush=True)
    run(["git", "worktree", "add", "--detach", str(dest), ref], cwd=REPO,
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    run(["make", "-j"], cwd=dest,
        stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    bin = dest / "build" / "jet"
    if not bin.exists():
        die(f"build did not produce {bin}")
    return bin


def remove_worktree(dest):
    subprocess.run(["git", "worktree", "remove", "--force", str(dest)],
                   cwd=REPO, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def time_run(cmd):
    s = time.perf_counter()
    r = subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    dt = time.perf_counter() - s
    if r.returncode != 0:
        die(f"benchmark exited {r.returncode}: {' '.join(map(str, cmd))}")
    return dt


def compile_bench(bin, src, bc):
    with bc.open("wb") as f:
        run([str(bin), "compile", str(src)], stdout=f)


def main():
    ap = argparse.ArgumentParser(
        description="Head-to-head A/B benchmark of two git refs.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=__doc__)
    ap.add_argument("ref_old", help="old git ref (e.g. HEAD~1, main)")
    ap.add_argument("ref_new", help="new git ref (e.g. HEAD, perf-branch)")
    ap.add_argument("-n", "--runs", type=int, default=20,
                    help="paired trials per bench (default 20)")
    ap.add_argument("-w", "--warmups", type=int, default=3,
                    help="untimed runs per binary per bench (default 3)")
    ap.add_argument("--seed", type=int, help="random seed for run order (printed if omitted)")
    ap.add_argument("-b", "--bench", action="append",
                    help="restrict to specific bench (repeatable)")
    ap.add_argument("--keep", action="store_true",
                    help="keep temp worktrees after run")
    args = ap.parse_args()
    if args.runs < 2 or args.warmups < 0:
        ap.error("--runs must be at least two and --warmups must be nonnegative")
    if args.seed is None:
        args.seed = random.SystemRandom().getrandbits(64)
    rng = random.Random(args.seed)

    benches = args.bench or DEFAULT_BENCHES

    # sanity-check refs resolve
    for ref in (args.ref_old, args.ref_new):
        r = subprocess.run(["git", "rev-parse", "--verify", f"{ref}^{{commit}}"],
                           cwd=REPO, capture_output=True)
        if r.returncode != 0:
            die(f"unknown git ref: {ref}")

    tmp = Path(tempfile.mkdtemp(prefix="ab-compare-"))
    wt_old = tmp / "old"
    wt_new = tmp / "new"
    bin_old = build_ref(args.ref_old, wt_old)
    bin_new = build_ref(args.ref_new, wt_new)

    print()
    print(f"  old:  {args.ref_old} ({short(args.ref_old)})  →  {bin_old}")
    print(f"  new:  {args.ref_new} ({short(args.ref_new)})  →  {bin_new}")
    print(f"  {args.runs} pairs, {args.warmups} warmups; seed {args.seed}; "
          "whole-process time, compilation excluded")
    print()

    bcs = {}
    skipped = []
    for b in benches:
        # Each ref compiles its own worktree copy of the benchmark, so the two refs
        # may differ in surface syntax while expressing the same workload.
        src_old = wt_old / "bench" / f"{b}.ss"
        src_new = wt_new / "bench" / f"{b}.ss"
        missing = [ref for ref, src in ((args.ref_old, src_old), (args.ref_new, src_new))
                   if not src.exists()]
        if missing:
            skipped.append((b, missing))
            continue
        bc_old = tmp / f"{b}.old.bc"
        bc_new = tmp / f"{b}.new.bc"
        compile_bench(bin_old, src_old, bc_old)
        compile_bench(bin_new, src_new, bc_new)
        bcs[b] = (bc_old, bc_new)

    if not bcs:
        die("no benchmarks present in both revisions")

    for b, missing in skipped:
        refs = " and ".join(short(ref) for ref in missing)
        print(f"  skipping {b}: no bench source in {refs}")
    if skipped:
        print()

    results = []
    show_progress(0, len(bcs))
    for i, (b, (bc_old, bc_new)) in enumerate(bcs.items(), 1):
        result = collect([str(bin_new), "exec", str(bc_new)],
                         [str(bin_old), "exec", str(bc_old)], args.runs, time_run,
                         warmups=args.warmups, rng=rng)
        results.append((b, result))
        show_progress(i, len(bcs))

    adjusted = holm_p([result.p for _, result in results])
    print()
    name_w = max(len(b) for b in bcs)
    print(f"  {'bench':<{name_w}}  new vs old")
    for (b, result), p in zip(results, adjusted):
        print(f"  {b:<{name_w}}  {percent_result(result.ratio, p < 0.05)}")

    if len(results) > 1:
        gm = statistics.geometric_mean(result.ratio for _, result in results)
        print(f"  overall ({len(results)} benches, geomean): "
              f"{percent_result(gm, True)}")
    print("  Benchmark results labelled faster/slower meet the 5% significance "
          "cutoff after adjustment.")

    if not args.keep:
        remove_worktree(wt_old)
        remove_worktree(wt_new)
    else:
        print(f"\n  worktrees kept: {wt_old} {wt_new}")


if __name__ == "__main__":
    main()
